@page "/fertigung/thermoformung"
@page "/fertigung/kiefel"
@inject IJSRuntime JS
@inject UserService UserService
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Thermoformung - Fertigung</PageTitle>

<div class="thermo-workbench pb-5">
    <section class="thermo-hero">
        <div class="thermo-hero-copy">
            <h1 class="thermo-title">Thermoformung</h1>
            <p class="thermo-hero-text">
                Produktionsläufe, Chargen und Freigaben für den laufenden Auftrag erfassen.
            </p>
        </div>

        <div class="thermo-hero-bar">
            <div class="thermo-hero-facts">
                <div class="thermo-inline-card thermo-inline-card-quantity">
                    <span class="thermo-inline-label">Fertigungsmenge</span>
                    <strong>@FertigungsmengeDisplay</strong>
                </div>

                <div class="thermo-inline-card">
                    <span class="thermo-inline-label">FA-Nr.</span>
                    <strong>@SelectedFaDisplay</strong>
                </div>

                <div class="thermo-inline-card thermo-inline-card-material">
                    <span class="thermo-inline-label">Material</span>
                    <strong>@MaterialDisplay</strong>
                </div>

                <div class="thermo-inline-card">
                    <span class="thermo-inline-label">Freigabe</span>
                    <span class="thermo-status-chip @FreigabeStatusClass">
                        <i class="fa-solid @(IsFreigegeben ? "fa-circle-check" : "fa-circle-exclamation")"></i>
                        @FreigabeStatusText
                    </span>
                </div>
            </div>

            <div class="thermo-command-actions thermo-command-actions-compact">
                <button type="button"
                        class="thermo-btn thermo-btn-secondary"
                        disabled="@(!HasSelectedFa)"
                        @onclick="ShowFreigabeListe">
                    <i class="fa-solid fa-list-check"></i>
                    Freigaben
                </button>
                <button type="button"
                        class="thermo-btn thermo-btn-primary"
                        disabled="@(!HasSelectedFa)"
                        @onclick="TryFreigeben">
                    <i class="fa-solid fa-shield-heart"></i>
                    Freigabe erteilen
                </button>
            </div>
        </div>
    </section>

    <section class="thermo-stage-grid">
        <article class="thermo-card">
            <div class="thermo-card-header">
                <div>
                    <span class="thermo-section-label">Schritt 1</span>
                    <h2 class="thermo-section-title">Auftragslauf erfassen</h2>
                    <p class="thermo-section-text">
                        Maschine, Zeitfenster und Bemerkung für den laufenden Auftrag dokumentieren.
                    </p>
                </div>
                <div class="thermo-counter-pill">
                    <strong>@Eingaben.Count</strong>
                    <span>Einträge</span>
                </div>
            </div>

            <div class="thermo-fields">
                <div class="thermo-grid-two">
                    <div class="thermo-field">
                        <label for="thermo-fa">FA-Nr</label>
                        <select id="thermo-fa" class="thermo-select" value="@SelectedFaNr" @onchange="OnFaNrChanged">
                            <option value="">Bitte auswählen...</option>
                            @foreach (var fa in FaNrs)
                            {
                                <option value="@fa">@fa</option>
                            }
                        </select>
                        <span class="thermo-field-hint">Material: @MaterialDisplay | Fertigungsmenge: @FertigungsmengeDisplay</span>
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-machine">Maschinen-Nr</label>
                        <select id="thermo-machine" class="thermo-select" @bind="MaschinenNr">
                            <option value="5192">5192</option>
                            <option value="5193">5193</option>
                        </select>
                    </div>
                </div>

                <div class="thermo-grid-two">
                    <div class="thermo-field">
                        <label for="thermo-start-date">Startdatum</label>
                        <input id="thermo-start-date" type="date" class="thermo-input" @bind="StartDate" />
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-end-date">Enddatum</label>
                        <input id="thermo-end-date" type="date" class="thermo-input" @bind="EndDate" />
                    </div>
                </div>

                <div class="thermo-grid-two">
                    <div class="thermo-field">
                        <label for="thermo-start-time">Startzeit</label>
                        <input id="thermo-start-time" type="time" class="thermo-input" @bind="StartTime" />
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-end-time">Endzeit</label>
                        <input id="thermo-end-time" type="time" class="thermo-input" @bind="EndTime" />
                    </div>
                </div>

                <div class="thermo-grid-two">
                    <div class="thermo-field">
                        <label for="thermo-break">Pausenzeit</label>
                        <div class="thermo-input-group">
                            <input id="thermo-break" type="number" class="thermo-input" @bind="Pausen" />
                            <span>min</span>
                        </div>
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-downtime">Ausfallzeit</label>
                        <div class="thermo-input-group">
                            <input id="thermo-downtime" type="number" class="thermo-input" @bind="Ausfall" />
                            <span>min</span>
                        </div>
                    </div>
                </div>

                <div class="thermo-field">
                    <label for="thermo-note">Bemerkung</label>
                    <textarea id="thermo-note"
                              class="thermo-textarea"
                              rows="4"
                              @bind="EingabeBemerkung"
                              placeholder="z.B. Rüstung, Störung, Materialwechsel"></textarea>
                </div>

                <div class="thermo-action-row">
                    <button type="button"
                            class="thermo-btn thermo-btn-primary thermo-btn-block"
                            disabled="@(!HasSelectedFa)"
                            @onclick="AddEingabe">
                        <i class="fa-solid fa-layer-group"></i>
                        Lauf hinzufügen
                    </button>
                </div>
            </div>
        </article>

        <article class="thermo-card">
            <div class="thermo-card-header">
                <div>
                    <span class="thermo-section-label">Schritt 2</span>
                    <h2 class="thermo-section-title">Chargen und Messwerte</h2>
                    <p class="thermo-section-text">
                        Verbrauch, Temperaturen und Gut-/Schlechtteile direkt am Auftrag verbuchen.
                    </p>
                </div>
                <div class="thermo-counter-pill thermo-counter-pill-accent">
                    <strong>@Chargen.Count</strong>
                    <span>gebucht</span>
                </div>
            </div>

            <div class="thermo-fields">
                <div class="thermo-field">
                    <label for="thermo-charge">Charge wählen oder scannen</label>
                    <select id="thermo-charge"
                            class="thermo-select thermo-charge-select @(IsSelectedChargeRed ? "is-alert" : "")"
                            value="@SelectedCharge"
                            @onchange="OnChargeChanged">
                        <option value="">Bitte auswählen...</option>
                        @foreach (var charge in AvailableChargen)
                        {
                            <option value="@charge.Charge" style="color: @(charge.IsRed ? "#ef4444" : "#22c55e")">
                                @GetChargeOptionLabel(charge)
                            </option>
                        }
                    </select>
                </div>

                @if (IsSelectedChargeRed)
                {
                    <div class="thermo-warning-ribbon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Ältere Charge wurde übersprungen. Die FIFO-Begründung wird beim Buchen abgefragt.
                    </div>
                }

                <div class="thermo-grid-two">
                    <div class="thermo-field">
                        <label for="thermo-lfm">Ist (Lfm)</label>
                        <input id="thermo-lfm" type="text" class="thermo-input" @bind="LfmIst" />
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-wkz">WKZ Temp</label>
                        <div class="thermo-input-group">
                            <input id="thermo-wkz" type="text" class="thermo-input" @bind="WKZTemp" />
                            <span>°C</span>
                        </div>
                    </div>
                </div>

                <div class="thermo-grid-two">
                    <div class="thermo-field">
                        <label for="thermo-verbrauch">Verbraucht (Lfm)</label>
                        <input id="thermo-verbrauch" type="text" class="thermo-input" @bind="Verbraucht" />
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-folie">Folie Temp</label>
                        <div class="thermo-input-group">
                            <input id="thermo-folie" type="text" class="thermo-input" @bind="FolieTemp" />
                            <span>°C</span>
                        </div>
                    </div>
                </div>

                <div class="thermo-grid-three">
                    <div class="thermo-field">
                        <label for="thermo-good">Gutteile</label>
                        <input id="thermo-good" type="text" class="thermo-input" @bind="Gutteile" />
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-bad-int">Schlecht intern</label>
                        <input id="thermo-bad-int" type="text" class="thermo-input" @bind="Schlechtteile" />
                    </div>

                    <div class="thermo-field">
                        <label for="thermo-bad-ext">Schlecht extern</label>
                        <input id="thermo-bad-ext" type="text" class="thermo-input" @bind="SchlechtteileExt" />
                    </div>
                </div>

                <div class="thermo-action-row thermo-action-row-end">
                    <button type="button"
                            class="thermo-btn thermo-btn-secondary"
                            disabled>
                        <i class="fa-solid fa-ban"></i>
                        Sperren
                    </button>
                    <button type="button"
                            class="thermo-btn thermo-btn-primary"
                            disabled="@(!CanAddCharge)"
                            @onclick="AddCharge">
                        <i class="fa-solid fa-barcode"></i>
                        Charge buchen
                    </button>
                </div>
            </div>
        </article>
    </section>

    <section class="thermo-board-grid">
        <article class="thermo-card">
            <div class="thermo-card-header">
                <div>
                    <span class="thermo-section-label">Board</span>
                    <h2 class="thermo-section-title">Auftragsläufe</h2>
                    <p class="thermo-section-text">Alle Zeitfenster für den geladenen Auftrag im Überblick.</p>
                </div>
            </div>

            <div class="thermo-table-wrap">
                <table class="thermo-table thermo-table-classic">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Maschine</th>
                            <th>Beginn</th>
                            <th>Ende</th>
                            <th>Pause</th>
                            <th>Ausfall</th>
                            <th>Bemerkung</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Eingaben.Any())
                        {
                            <tr>
                                <td colspan="7" class="thermo-empty-cell">Noch keine Auftragsläufe erfasst.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var eingabe in Eingaben)
                            {
                                <tr>
                                    <td class="thermo-col-action">
                                        <button type="button" class="thermo-delete-link" @onclick="() => RemoveEingabe(eingabe)">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    </td>
                                    <td>@eingabe.MaschinenNr</td>
                                    <td>@FormatDateValue(eingabe.Begin)</td>
                                    <td>@FormatDateValue(eingabe.Ende)</td>
                                    <td class="thermo-table-amount">@($"{eingabe.Pausen} min")</td>
                                    <td class="thermo-table-amount">@($"{eingabe.Ausfall} min")</td>
                                    <td>@(string.IsNullOrWhiteSpace(eingabe.Bemerkung) ? "-" : eingabe.Bemerkung)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="thermo-card">
            <div class="thermo-card-header">
                <div>
                    <span class="thermo-section-label">Board</span>
                    <h2 class="thermo-section-title">Chargenliste</h2>
                    <p class="thermo-section-text">Kompakte Übersicht wie in der alten Ansicht, aber sauber im neuen Design.</p>
                </div>
            </div>

            <div class="thermo-table-wrap">
                <table class="thermo-table thermo-table-classic thermo-table-wide">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Charge</th>
                            <th>Lfm Ist</th>
                            <th>Verbr.</th>
                            <th>Gut</th>
                            <th>Schlecht</th>
                            <th>Schlecht ext.</th>
                            <th>WKZ °C</th>
                            <th>Folie °C</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Chargen.Any())
                        {
                            <tr>
                                <td colspan="9" class="thermo-empty-cell">Noch keine Chargen für diesen Auftrag gebucht.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var charge in Chargen)
                            {
                                <tr>
                                    <td class="thermo-col-action">
                                        <button type="button" class="thermo-delete-link" @onclick="() => RemoveCharge(charge)">
                                            <i class="fa-solid fa-times"></i>
                                        </button>
                                    </td>
                                    <td>@charge.Charge</td>
                                    <td class="thermo-table-amount">@charge.Flfmlst</td>
                                    <td class="thermo-table-amount">@charge.Verbraucht</td>
                                    <td class="thermo-table-amount">@charge.Gutteile</td>
                                    <td class="thermo-table-amount">@charge.Schlechtteile</td>
                                    <td class="thermo-table-amount">@charge.SchlechtteileExt</td>
                                    <td class="thermo-table-amount">@(string.IsNullOrWhiteSpace(charge.WKZTemp) ? "-" : charge.WKZTemp)</td>
                                    <td class="thermo-table-amount">@(string.IsNullOrWhiteSpace(charge.FolienTemp) ? "-" : charge.FolienTemp)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </article>
    </section>

    <section class="thermo-finish-bar">
        <div class="thermo-status-panel">
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="thermo-status-note @(HasErrorStatus ? "is-error" : "is-success")">
                    <i class="fa-solid @(HasErrorStatus ? "fa-circle-exclamation" : "fa-circle-check")"></i>
                    <span>@statusMessage</span>
                </div>
            }
            else
            {
                <div class="thermo-status-placeholder">
                    <strong>Bereit zum Speichern</strong>
                    <span>Freigabe, Chargen und Auftragsläufe werden gemeinsam gespeichert.</span>
                </div>
            }
        </div>

        <div class="thermo-finish-actions">
            <label class="thermo-toggle">
                <input type="checkbox" @bind="Abgesendet" />
                <span class="thermo-toggle-copy">
                    <strong>Auftrag abschließen</strong>
                    <span>markiert den Auftrag nach dem Speichern als fertig</span>
                </span>
            </label>

            <button type="button"
                    class="thermo-btn thermo-btn-primary thermo-save-button"
                    disabled="@(!HasSelectedFa)"
                    @onclick="SaveAll">
                <i class="fa-solid fa-floppy-disk"></i>
                @SaveButtonLabel
            </button>
        </div>
    </section>
</div>

<FreigabeModal @bind-IsOpen="isFreigabeModalOpen"
               FaNr="@SelectedFaNr"
               Typ="FreigabeTyp.Thermoformung"
               Mode="freigabeModalMode"
               OnSuccess="RefreshFreigabeStatus" />

@code {
    private List<string> FaNrs = new();
    private string SelectedFaNr = "";
    private string Material = "Kein Material geladen";
    private string Fertigungsmenge = "0";
    private bool IsFreigegeben = false;
    private string statusMessage = "";

    private string SelectedFaDisplay => string.IsNullOrWhiteSpace(SelectedFaNr) ? "Keine Auswahl" : SelectedFaNr;
    private string MaterialDisplay => FormatMaterialDisplay(Material);
    private string FertigungsmengeDisplay => string.IsNullOrWhiteSpace(Fertigungsmenge) ? "0" : Fertigungsmenge;
    private bool HasSelectedFa => !string.IsNullOrWhiteSpace(SelectedFaNr);
    private bool CanAddCharge => HasSelectedFa && !string.IsNullOrWhiteSpace(SelectedCharge) && !string.IsNullOrWhiteSpace(LfmIst);
    private string FreigabeStatusClass => IsFreigegeben ? "is-approved" : "is-blocked";
    private string FreigabeStatusText => IsFreigegeben ? "Freigegeben" : "Freigabe fehlt";
    private string SaveButtonLabel => Abgesendet ? "Speichern und abschließen" : "Zwischenspeichern";
    private bool HasErrorStatus =>
        !string.IsNullOrWhiteSpace(statusMessage) &&
        (statusMessage.Contains("fehler", StringComparison.OrdinalIgnoreCase) ||
         statusMessage.Contains("kritisch", StringComparison.OrdinalIgnoreCase) ||
         statusMessage.Contains("system", StringComparison.OrdinalIgnoreCase));

    private string MaschinenNr = "5192";
    private DateTime? StartDate = DateTime.Today;
    private DateTime? EndDate = DateTime.Today;
    private TimeOnly? StartTime = new TimeOnly(6, 0);
    private TimeOnly? EndTime = new TimeOnly(14, 0);
    private string Pausen = "0";
    private string Ausfall = "0";
    private string EingabeBemerkung = "";

    private List<ChargeComboItem> AvailableChargen = new();
    private string SelectedCharge = "";
    private bool IsSelectedChargeRed = false;
    private string LfmIst = "";
    private string Verbraucht = "";
    private string Gutteile = "0";
    private string Schlechtteile = "0";
    private string SchlechtteileExt = "0";
    private string WKZTemp = "";
    private string FolieTemp = "";
    private string FIFO = "";

    private bool Abgesendet = false;

    private List<EingabeDaten> Eingaben = new();
    private List<FChargeDaten> Chargen = new();

    protected override async Task OnInitializedAsync()
    {
        FaNrs = await ThermoformungService.GetOpenFANrsAsync();
    }

    private async Task OnFaNrChanged(ChangeEventArgs e)
    {
        SelectedFaNr = e.Value?.ToString() ?? "";
        statusMessage = "";

        if (string.IsNullOrEmpty(SelectedFaNr))
        {
            ResetLoadedData();
            return;
        }

        var data = await ThermoformungService.GetDataForFANrAsync(SelectedFaNr);
        Eingaben = data.Eingaben;
        Chargen = data.Chargen;
        Material = string.IsNullOrWhiteSpace(data.Material) ? "Kein Material geladen" : data.Material;
        Fertigungsmenge = string.IsNullOrWhiteSpace(data.Fertigungsmenge) ? "0" : data.Fertigungsmenge;

        IsFreigegeben = await FreigabeService.CheckFreigabeTodayAsync(SelectedFaNr, FreigabeTyp.Thermoformung);
        AvailableChargen = await ThermoformungService.GetAvailableChargenAsync(SelectedFaNr);
    }

    private void OnChargeChanged(ChangeEventArgs e)
    {
        SelectedCharge = e.Value?.ToString() ?? "";
        var match = AvailableChargen.FirstOrDefault(c => c.Charge == SelectedCharge);
        IsSelectedChargeRed = match?.IsRed ?? false;
    }

    private async Task AddEingabe()
    {
        if (StartDate == null || EndDate == null || StartTime == null || EndTime == null || string.IsNullOrWhiteSpace(EingabeBemerkung))
        {
            await JS.InvokeVoidAsync("alert", "Bitte fülle alle markierten Felder und die Bemerkung aus.");
            return;
        }

        DateTime begin = StartDate.Value.Date + StartTime.Value.ToTimeSpan();
        DateTime ende = EndDate.Value.Date + EndTime.Value.ToTimeSpan();

        bool exists = Eingaben.Any(eingabe =>
            eingabe.MaschinenNr == MaschinenNr &&
            DateTime.TryParse(eingabe.Begin, out var beginLoaded) && beginLoaded == begin &&
            DateTime.TryParse(eingabe.Ende, out var endeLoaded) && endeLoaded == ende);

        if (exists)
        {
            await JS.InvokeVoidAsync("alert", "Ein Eintrag mit dieser Maschine und diesem Zeitraum existiert bereits.");
            return;
        }

        Eingaben.Add(new EingabeDaten
        {
            MaschinenNr = MaschinenNr,
            Begin = begin.ToString("yyyy-MM-dd HH:mm:ss"),
            Ende = ende.ToString("yyyy-MM-dd HH:mm:ss"),
            Pausen = Pausen,
            Ausfall = Ausfall,
            Bemerkung = EingabeBemerkung,
            IsNewRowAuftrag = true
        });
        StateHasChanged();
    }

    private async Task AddCharge()
    {
        if (string.IsNullOrWhiteSpace(SelectedCharge) || string.IsNullOrWhiteSpace(LfmIst))
        {
            return;
        }

        FIFO = "";
        if (IsSelectedChargeRed)
        {
            FIFO = await JS.InvokeAsync<string>("prompt", "Achtung: Sie buchen einen FIFO-Verstoß. Bitte geben Sie eine Begründung ein:");
            if (string.IsNullOrWhiteSpace(FIFO))
            {
                return;
            }
        }

        Chargen.Add(new FChargeDaten
        {
            Charge = SelectedCharge,
            Flfmlst = LfmIst,
            Verbraucht = Verbraucht,
            Gutteile = Gutteile,
            Schlechtteile = Schlechtteile,
            SchlechtteileExt = SchlechtteileExt,
            WKZTemp = WKZTemp,
            FolienTemp = FolieTemp,
            FIFO = FIFO,
            IsNewRow = true
        });

        AvailableChargen.RemoveAll(c => c.Charge == SelectedCharge);
        SelectedCharge = "";
        IsSelectedChargeRed = false;
        FIFO = "";
        StateHasChanged();
    }

    private async Task SaveAll()
    {
        try
        {
            statusMessage = "Prüfe Freigabe...";
            StateHasChanged();
            await Task.Delay(1);

            if (string.IsNullOrEmpty(SelectedFaNr))
            {
                statusMessage = "Fehler: Kein Fertigungsauftrag ausgewählt.";
                return;
            }

            bool approved = await FreigabeService.CheckFreigabeTodayAsync(SelectedFaNr, FreigabeTyp.Thermoformung);
            if (!approved)
            {
                statusMessage = "Fehler: Keine Freigabe für heute erteilt.";
                IsFreigegeben = false;
                return;
            }

            statusMessage = "Speichere Daten...";
            StateHasChanged();

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            string actualUserName = user?.Identity?.Name ?? "Unbekannt";
            string pNummer = user?.Claims.FirstOrDefault(c => c.Type == "UserId")?.Value ?? "100";
            var userSession = new UserSession { Name = actualUserName, Personalnummer = pNummer };

            bool success = await ThermoformungService.SaveDataAsync(SelectedFaNr, Abgesendet, Eingaben, Chargen, Material, userSession);

            if (success)
            {
                statusMessage = "Daten erfolgreich gespeichert.";
                if (Abgesendet)
                {
                    ResetLoadedData();
                    SelectedFaNr = "";
                }
            }
            else
            {
                statusMessage = "Kritischer Fehler beim Speichern.";
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Systemfehler: {ex.Message}";
            Console.WriteLine($"SaveAll Exception: {ex}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    private bool isFreigabeModalOpen = false;
    private FreigabeModal.ModalMode freigabeModalMode = FreigabeModal.ModalMode.List;

    private void ShowFreigabeListe()
    {
        if (string.IsNullOrEmpty(SelectedFaNr))
        {
            return;
        }

        freigabeModalMode = FreigabeModal.ModalMode.List;
        isFreigabeModalOpen = true;
    }

    private void TryFreigeben()
    {
        if (string.IsNullOrEmpty(SelectedFaNr))
        {
            return;
        }

        freigabeModalMode = FreigabeModal.ModalMode.Create;
        isFreigabeModalOpen = true;
    }

    private async Task RefreshFreigabeStatus()
    {
        IsFreigegeben = await FreigabeService.CheckFreigabeTodayAsync(SelectedFaNr, FreigabeTyp.Thermoformung);
        StateHasChanged();
    }

    private void RemoveEingabe(EingabeDaten row)
    {
        Eingaben.Remove(row);
    }

    private void RemoveCharge(FChargeDaten row)
    {
        Chargen.Remove(row);
    }

    private void ResetLoadedData()
    {
        Eingaben.Clear();
        Chargen.Clear();
        AvailableChargen.Clear();
        Material = "Kein Material geladen";
        Fertigungsmenge = "0";
        IsFreigegeben = false;
        SelectedCharge = "";
        IsSelectedChargeRed = false;
        FIFO = "";
    }

    private static int ParseInt(string? value)
    {
        return int.TryParse(value, out var parsed) ? parsed : 0;
    }

    private static string GetChargeOptionLabel(ChargeComboItem charge)
    {
        string marker = charge.IsRed ? "🔴" : "🟢";
        string dateText = charge.Eingangsdatum == DateTime.MaxValue
            ? ""
            : charge.Eingangsdatum.ToString("dd.MM.yyyy");

        return string.IsNullOrWhiteSpace(dateText)
            ? $"{marker} {charge.Charge}"
            : $"{marker} {charge.Charge} | {dateText}";
    }

    private static string FormatDateValue(string? value)
    {
        if (DateTime.TryParse(value, out var parsed))
        {
            return parsed.ToString("dd.MM.yyyy HH:mm");
        }

        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private static string FormatMaterialDisplay(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Kein Material geladen";
        }

        string display = value;
        int separatorIndex = display.IndexOf(';');
        if (separatorIndex >= 0 && separatorIndex < display.Length - 1)
        {
            display = display[(separatorIndex + 1)..];
        }

        int commaIndex = display.IndexOf(',');
        if (commaIndex >= 0)
        {
            display = display[..commaIndex];
        }

        int slashIndex = display.IndexOf(" / ", StringComparison.Ordinal);
        if (slashIndex >= 0)
        {
            display = display[..slashIndex];
        }

        display = display.Trim();
        return string.IsNullOrWhiteSpace(display) ? "Kein Material geladen" : display;
    }
}
