@page "/verwaltung/fehleranalyse"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using ApexCharts
@using Microsoft.JSInterop
@using QIN_Production_Web.Data
@inject FehleranalyseService AnalyseService
@inject IJSRuntime JS

<PageTitle>Fehleranalyse - Verwaltung</PageTitle>

<div class="fehleranalyse-page qin-page-shell pb-3">

    <div class="row g-3 mb-3 align-items-stretch">
        <div class="col-xl-3 col-lg-4">
            <div class="glass-card qin-panel d-flex flex-column h-100">
                <div class="card-title-modern d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-filter text-primary"></i>
                        <span>Filter</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="qin-badge fehleranalyse-status-badge @(HasResults ? "qin-badge-info" : "qin-badge-neutral")">
                            <i class="fa-solid @(IsLoading ? "fa-spinner fa-spin" : HasResults ? "fa-chart-line" : "fa-circle-check")"></i>
                            @(IsLoading ? "Lädt..." : HasResults ? $"{Eintraege.Count}" : "Bereit")
                        </span>
                        <button class="btn qin-btn-ghost btn-sm fehleranalyse-filter-reset" title="Filter zurücksetzen" @onclick="ResetFilter">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="modern-label">Charge</label>
                        <div class="qin-input-shell">
                            <i class="fa-solid fa-barcode qin-input-icon"></i>
                            <input type="text"
                                   class="form-control qin-input"
                                   placeholder="Charge suchen..."
                                   @bind="SearchCharge"
                                   @bind:after="TriggerAnalyseAsync" />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="modern-label">Kunde</label>
                        <select class="form-select modern-select" value="@SelectedKunde" @onchange="OnKundeChanged">
                            <option value="">Alle Kunden</option>
                            @foreach (var kunde in Kunden)
                            {
                                <option value="@kunde.Name" style="@(kunde.IsActive ? null : "color: var(--text-secondary); font-style: italic;")">
                                    @kunde.Name @(kunde.IsActive ? string.Empty : "(Inaktiv)")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="modern-label">Projekt</label>
                        <select class="form-select modern-select" value="@SelectedProjekt" @onchange="OnProjektChanged">
                            <option value="">Alle Projekte</option>
                            @foreach (var projekt in Projekte)
                            {
                                <option value="@projekt">@projekt</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="modern-label">Artikel</label>
                        <select class="form-select modern-select" @bind="SelectedArtikel" @bind:after="TriggerAnalyseAsync">
                            <option value="">Alle Artikel</option>
                            @foreach (var artikel in ArtikelListe)
                            {
                                <option value="@artikel">@artikel</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="modern-label">Dekor</label>
                        <select class="form-select modern-select" @bind="SelectedDekor" @bind:after="TriggerAnalyseAsync">
                            <option value="">Alle Dekore</option>
                            @foreach (var dekor in DekorListe)
                            {
                                <option value="@dekor">@dekor</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <label class="modern-label">Datum von</label>
                        <input type="date" class="form-control modern-input" @bind="StartDatum" @bind:after="TriggerAnalyseAsync" />
                    </div>
                    <div class="col-6">
                        <label class="modern-label">Datum bis</label>
                        <input type="date" class="form-control modern-input" @bind="EndDatum" @bind:after="TriggerAnalyseAsync" />
                    </div>
                </div>

                <div class="fehleranalyse-filter-footer mt-3">
                    <button class="btn qin-btn-ghost w-100 fw-bold" @onclick="ExportData" disabled="@(!Eintraege.Any() || IsLoading)">
                        <i class="fa-solid fa-file-excel text-success me-2"></i> Export
                    </button>
                </div>
            </div>
        </div>

        <div class="col-xl-9 col-lg-8">
            <div class="glass-card qin-panel d-flex flex-column h-100 fehleranalyse-results-panel">
                <ul class="qin-tab-nav" role="tablist">
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "gesamt" ? "active" : null)" @onclick='() => ActiveTab = "gesamt"'>Gesamt</button>
                    </li>
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "eintraege" ? "active" : null)" @onclick='() => ActiveTab = "eintraege"'>Einzelne Einträge</button>
                    </li>
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "bar" ? "active" : null)" @onclick='() => ActiveTab = "bar"'>Balkendiagramm</button>
                    </li>
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "pie" ? "active" : null)" @onclick='() => ActiveTab = "pie"'>Tortendiagramm</button>
                    </li>
                </ul>

                <div class="fehleranalyse-tab-content">
                    <div class="@(ActiveTab == "gesamt" ? string.Empty : "d-none")">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h5 class="fehleranalyse-section-title">
                                    <i class="fa-solid fa-arrow-right-from-bracket text-primary me-2"></i>Externe Fehler
                                </h5>
                                <div class="modern-table-container qin-table-shell">
                                    <table class="modern-table qin-table">
                                        <thead>
                                            <tr>
                                                <th>Karte Extern</th>
                                                <th class="text-end">Anzahl</th>
                                                <th class="text-end">Prozent</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!ExterneFehler.Any())
                                            {
                                                <tr>
                                                    <td colspan="3" class="qin-empty-state">Wählen Sie Filter aus, um Daten zu laden.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in ExterneFehler)
                                                {
                                                    <tr class="@(item.Karte.StartsWith("Schlecht") ? "fehleranalyse-emphasis-row" : null)">
                                                        <td>@item.Karte</td>
                                                        <td class="text-end">@item.Anzahl</td>
                                                        <td class="text-end">@(item.Prozent?.ToString("P2"))</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h5 class="fehleranalyse-section-title">
                                    <i class="fa-solid fa-arrow-right-to-bracket text-primary me-2"></i>Interne Fehler
                                </h5>
                                <div class="modern-table-container qin-table-shell">
                                    <table class="modern-table qin-table">
                                        <thead>
                                            <tr>
                                                <th>Karte Intern</th>
                                                <th class="text-end">Anzahl</th>
                                                <th class="text-end">Prozent</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!InterneFehler.Any())
                                            {
                                                <tr>
                                                    <td colspan="3" class="qin-empty-state">Wählen Sie Filter aus, um Daten zu laden.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in InterneFehler)
                                                {
                                                    <tr class="@(item.Karte.StartsWith("Schlecht") ? "fehleranalyse-emphasis-row" : null)">
                                                        <td>@item.Karte</td>
                                                        <td class="text-end">@item.Anzahl</td>
                                                        <td class="text-end">@(item.Prozent?.ToString("P2"))</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="qin-stat-grid mt-4">
                            <div class="qin-stat-card fehleranalyse-stat-card fehleranalyse-stat-card-good">
                                <span class="modern-label d-block mb-2 text-success">Gutteile</span>
                                <span class="qin-stat-card-value">
                                    @GesamtResult.Gutteile
                                    <small class="qin-stat-card-subvalue">(@GoodPercentage)</small>
                                </span>
                            </div>
                            <div class="qin-stat-card fehleranalyse-stat-card fehleranalyse-stat-card-bad">
                                <span class="modern-label d-block mb-2 text-danger">Schlechtteile</span>
                                <span class="qin-stat-card-value">
                                    @GesamtResult.Schlechtteile
                                    <small class="qin-stat-card-subvalue">(@BadPercentage)</small>
                                </span>
                            </div>
                            <div class="qin-stat-card fehleranalyse-stat-card fehleranalyse-stat-card-total">
                                <span class="modern-label d-block mb-2 text-primary">Gesamt</span>
                                <span class="qin-stat-card-value">@GesamtResult.Gesamt</span>
                            </div>
                        </div>
                    </div>

                    <div class="@(ActiveTab == "eintraege" ? string.Empty : "d-none")">
                        <div class="modern-table-container qin-table-shell fehleranalyse-entries-shell">
                            <table id="fehleranalyse-eintraege-table" class="modern-table qin-table entries-grid fehleranalyse-entries-table">
                                <thead>
                                    <tr>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Datum")'><span>Datum</span><i class="@SortIcon("Datum")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Charge")'><span>Charge</span><i class="@SortIcon("Charge")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Kunde")'><span>Kunde</span><i class="@SortIcon("Kunde")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Projekt")'><span>Projekt</span><i class="@SortIcon("Projekt")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Artikel")'><span>Artikel</span><i class="@SortIcon("Artikel")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Dekor")'><span>Dekor</span><i class="@SortIcon("Dekor")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Fusseln")'><span>Fus.</span><i class="@SortIcon("Fusseln")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Nadelstiche")'><span>Nad.</span><i class="@SortIcon("Nadelstiche")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Pickel")'><span>Pic.</span><i class="@SortIcon("Pickel")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Dekorfehler")'><span>Dek.</span><i class="@SortIcon("Dekorfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Farbfehler")'><span>Far.</span><i class="@SortIcon("Farbfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Flecken")'><span>Fle.</span><i class="@SortIcon("Flecken")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Nebel")'><span>Neb.</span><i class="@SortIcon("Nebel")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Vertiefung")'><span>Ver.</span><i class="@SortIcon("Vertiefung")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Oelflecken")'><span>Öl</span><i class="@SortIcon("Oelflecken")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Tiefziehfehler")'><span>Tie.</span><i class="@SortIcon("Tiefziehfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Fraesfehler")'><span>Frä.</span><i class="@SortIcon("Fraesfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Knicke")'><span>Kni.</span><i class="@SortIcon("Knicke")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Kratzer")'><span>Kra.</span><i class="@SortIcon("Kratzer")"></i></th>
                                        <th class="sortable-resizable-header text-success text-end" @onclick='() => SortBy("Gutteile")'><span>Gut</span><i class="@SortIcon("Gutteile")"></i></th>
                                        <th class="sortable-resizable-header text-danger text-end" @onclick='() => SortBy("Schlechtteile")'><span>Schl.</span><i class="@SortIcon("Schlechtteile")"></i></th>
                                        <th class="sortable-resizable-header text-primary text-end" @onclick='() => SortBy("Gesamt")'><span>Ges.</span><i class="@SortIcon("Gesamt")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Mitarbeiter")'><span>Mitarbeiter</span><i class="@SortIcon("Mitarbeiter")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Bemerkung")'><span>Bemerkung</span><i class="@SortIcon("Bemerkung")"></i></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Eintraege.Any())
                                    {
                                        <tr>
                                            <td colspan="24" class="qin-empty-state">Keine Datensätze gefunden.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in SortedEintraege)
                                        {
                                            <tr>
                                                <td>@row.FSKdate.ToString("dd.MM.yyyy")</td>
                                                <td class="fw-bold">@row.Charge</td>
                                                <td title="@row.Kunde">@TruncateText(row.Kunde, 10)</td>
                                                <td title="@row.Projekt">@TruncateText(row.Projekt, 10)</td>
                                                <td title="@row.Artikel">@TruncateText(row.Artikel, 15)</td>
                                                <td>@row.Dekor</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Fusseln)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Nadelstiche)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Pickel)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Dekorfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Farbfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Flecken)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Nebel)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Vertiefung)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Oelflecken)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Tiefziehfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Fraesfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Knicke)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Kratzer)</td>
                                                <td class="text-success text-end fw-bold">@row.Gutteile</td>
                                                <td class="text-danger text-end fw-bold">@row.Schlechtteile</td>
                                                <td class="text-primary text-end fw-bold">@row.Gesamt</td>
                                                <td class="text-info fw-bold">@row.PersonalName</td>
                                                <td title="@row.Bemerkungen" class="fehleranalyse-note-cell">
                                                    @(string.IsNullOrWhiteSpace(row.Bemerkungen) ? "-" : row.Bemerkungen)
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="fehleranalyse-chart-pane @(ActiveTab == "bar" ? string.Empty : "d-none")">
                        @if (!ChartData.Any())
                        {
                            <div class="qin-empty-state">Keine Datensätze gefunden.</div>
                        }
                        else
                        {
                            <div class="fehleranalyse-chart-card">
                                <ApexChart @key="CurrentTheme" TItem="ChargeItem" Options="@ChartOptions" Height="500">
                                    <ApexPointSeries TItem="ChargeItem"
                                                     Items="ChartData"
                                                     Name="Fehleranzahl"
                                                     SeriesType="SeriesType.Bar"
                                                     XValue="@(e => e.Karte)"
                                                     YValue="@(e => (decimal?)e.Anzahl)" />
                                </ApexChart>
                            </div>
                        }
                    </div>

                    <div class="fehleranalyse-chart-pane fehleranalyse-chart-pane-compact @(ActiveTab == "pie" ? string.Empty : "d-none")">
                        @if (!ChartData.Any())
                        {
                            <div class="qin-empty-state">Keine Datensätze gefunden.</div>
                        }
                        else
                        {
                            <div class="fehleranalyse-donut-shell">
                                <ApexChart @key="CurrentTheme" TItem="ChargeItem" Options="@PieOptions" Height="400">
                                    <ApexPointSeries TItem="ChargeItem"
                                                     Items="ChartData"
                                                     Name="Verteilung"
                                                     SeriesType="SeriesType.Donut"
                                                     XValue="@(e => e.Karte)"
                                                     YAggregate="@(e => (decimal?)e.Sum(x => x.Anzahl))" />
                                </ApexChart>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string EntriesTableId = "fehleranalyse-eintraege-table";

    private string ActiveTab = "gesamt";
    private string SearchCharge = string.Empty;
    private string SelectedKunde = string.Empty;
    private string SelectedProjekt = string.Empty;
    private string SelectedArtikel = string.Empty;
    private string SelectedDekor = string.Empty;
    private string CurrentTheme = "dark";
    private DateTime StartDatum = DateTime.Now;
    private DateTime EndDatum = DateTime.Now;

    private DotNetObjectReference<Fehleranalyse>? ThemeReference;
    private string? ThemeSubscriptionId;

    private List<CustomerData> Kunden = new();
    private List<string> Projekte = new();
    private List<string> ArtikelListe = new();
    private List<string> DekorListe = new();

    private List<FehlerRow> Eintraege = new();
    private FehlerAnalyseResult GesamtResult = new();
    private List<ChargeItem> ExterneFehler = new();
    private List<ChargeItem> InterneFehler = new();
    private List<ChargeItem> ChartData = new();
    private bool IsLoading;
    private bool AnalysePending;
    private string SortColumn = "Datum";
    private bool SortDescending = true;

    private ApexChartOptions<ChargeItem> ChartOptions = CreateBarChartOptions(false);
    private ApexChartOptions<ChargeItem> PieOptions = CreatePieChartOptions(false);

    private bool HasResults => Eintraege.Any();

    private string GoodPercentage => GesamtResult.Gesamt > 0
        ? ((double)GesamtResult.Gutteile / GesamtResult.Gesamt).ToString("P2")
        : "0.00%";

    private string BadPercentage => GesamtResult.Gesamt > 0
        ? ((double)GesamtResult.Schlechtteile / GesamtResult.Gesamt).ToString("P2")
        : "0.00%";

    private IEnumerable<FehlerRow> SortedEintraege => SortColumn switch
    {
        "Datum" => SortDescending ? Eintraege.OrderByDescending(x => x.FSKdate) : Eintraege.OrderBy(x => x.FSKdate),
        "Charge" => SortString(x => x.Charge),
        "Kunde" => SortString(x => x.Kunde),
        "Projekt" => SortString(x => x.Projekt),
        "Artikel" => SortString(x => x.Artikel),
        "Dekor" => SortString(x => x.Dekor),
        "Fusseln" => SortNumber(x => x.Fusseln),
        "Nadelstiche" => SortNumber(x => x.Nadelstiche),
        "Pickel" => SortNumber(x => x.Pickel),
        "Dekorfehler" => SortNumber(x => x.Dekorfehler),
        "Farbfehler" => SortNumber(x => x.Farbfehler),
        "Flecken" => SortNumber(x => x.Flecken),
        "Nebel" => SortNumber(x => x.Nebel),
        "Vertiefung" => SortNumber(x => x.Vertiefung),
        "Oelflecken" => SortNumber(x => x.Oelflecken),
        "Tiefziehfehler" => SortNumber(x => x.Tiefziehfehler),
        "Fraesfehler" => SortNumber(x => x.Fraesfehler),
        "Knicke" => SortNumber(x => x.Knicke),
        "Kratzer" => SortNumber(x => x.Kratzer),
        "Gutteile" => SortNumber(x => x.Gutteile),
        "Schlechtteile" => SortNumber(x => x.Schlechtteile),
        "Gesamt" => SortNumber(x => x.Gesamt),
        "Mitarbeiter" => SortString(x => x.PersonalName),
        "Bemerkung" => SortString(x => x.Bemerkungen),
        _ => Eintraege
    };

    protected override async Task OnInitializedAsync()
    {
        Kunden = await AnalyseService.GetKundenAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("makeTableResizable", EntriesTableId);

        ThemeReference = DotNetObjectReference.Create(this);
        ThemeSubscriptionId = await JS.InvokeAsync<string>("qinTheme.subscribe", ThemeReference);

        var theme = await JS.InvokeAsync<string>("qinTheme.getCurrent");
        if (ApplyChartTheme(theme))
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnThemeChanged(string theme)
    {
        if (ApplyChartTheme(theme))
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrWhiteSpace(ThemeSubscriptionId))
        {
            try
            {
                await JS.InvokeVoidAsync("qinTheme.unsubscribe", ThemeSubscriptionId);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        ThemeReference?.Dispose();
    }

    private async Task OnKundeChanged(ChangeEventArgs e)
    {
        SelectedKunde = e.Value?.ToString() ?? string.Empty;
        SelectedProjekt = string.Empty;
        SelectedArtikel = string.Empty;
        SelectedDekor = string.Empty;
        Projekte = await AnalyseService.GetProjekteAsync(SelectedKunde);
        ArtikelListe.Clear();
        DekorListe.Clear();
        await TriggerAnalyseAsync();
    }

    private async Task OnProjektChanged(ChangeEventArgs e)
    {
        SelectedProjekt = e.Value?.ToString() ?? string.Empty;
        SelectedArtikel = string.Empty;
        SelectedDekor = string.Empty;
        var result = await AnalyseService.GetArtikelsAndDekorsAsync(SelectedProjekt);
        ArtikelListe = result.Artikels;
        DekorListe = result.Dekors;
        await TriggerAnalyseAsync();
    }

    private async Task TriggerAnalyseAsync()
    {
        AnalysePending = true;

        if (IsLoading)
        {
            return;
        }

        while (AnalysePending)
        {
            AnalysePending = false;
            await StartAnalyseAsync();
        }
    }

    private async Task StartAnalyseAsync()
    {
        IsLoading = true;
        StateHasChanged();

        await Task.Delay(50);

        Eintraege = await AnalyseService.GetRawFehlerRowsAsync(
            SearchCharge,
            SelectedKunde,
            SelectedProjekt,
            SelectedArtikel,
            SelectedDekor,
            StartDatum,
            EndDatum);

        GesamtResult = new FehlerAnalyseResult
        {
            Fusseln = Eintraege.Sum(x => x.Fusseln),
            Nadelstiche = Eintraege.Sum(x => x.Nadelstiche),
            Pickel = Eintraege.Sum(x => x.Pickel),
            Dekorfehler = Eintraege.Sum(x => x.Dekorfehler),
            Farbfehler = Eintraege.Sum(x => x.Farbfehler),
            Flecken = Eintraege.Sum(x => x.Flecken),
            Nebel = Eintraege.Sum(x => x.Nebel),
            Vertiefung = Eintraege.Sum(x => x.Vertiefung),
            Oelflecken = Eintraege.Sum(x => x.Oelflecken),
            Tiefziehfehler = Eintraege.Sum(x => x.Tiefziehfehler),
            Fraesfehler = Eintraege.Sum(x => x.Fraesfehler),
            Knicke = Eintraege.Sum(x => x.Knicke),
            Kratzer = Eintraege.Sum(x => x.Kratzer),
            Gutteile = Eintraege.Sum(x => x.Gutteile)
        };

        var total = GesamtResult.Gesamt == 0 ? 1 : GesamtResult.Gesamt;

        ExterneFehler = new List<ChargeItem>
        {
            new() { Karte = "Fusseln", Anzahl = GesamtResult.Fusseln, Prozent = (double)GesamtResult.Fusseln / total },
            new() { Karte = "Nadelstiche", Anzahl = GesamtResult.Nadelstiche, Prozent = (double)GesamtResult.Nadelstiche / total },
            new() { Karte = "Pickel", Anzahl = GesamtResult.Pickel, Prozent = (double)GesamtResult.Pickel / total },
            new() { Karte = "Dekorfehler", Anzahl = GesamtResult.Dekorfehler, Prozent = (double)GesamtResult.Dekorfehler / total },
            new() { Karte = "Farbfehler", Anzahl = GesamtResult.Farbfehler, Prozent = (double)GesamtResult.Farbfehler / total },
            new() { Karte = "Flecken", Anzahl = GesamtResult.Flecken, Prozent = (double)GesamtResult.Flecken / total },
            new() { Karte = "Nebel", Anzahl = GesamtResult.Nebel, Prozent = (double)GesamtResult.Nebel / total },
            new() { Karte = "Vertiefung", Anzahl = GesamtResult.Vertiefung, Prozent = (double)GesamtResult.Vertiefung / total },
            new() { Karte = "Schlecht Extern", Anzahl = GesamtResult.SchlechtExtern, Prozent = (double)GesamtResult.SchlechtExtern / total }
        };

        InterneFehler = new List<ChargeItem>
        {
            new() { Karte = "Ölflecken", Anzahl = GesamtResult.Oelflecken, Prozent = (double)GesamtResult.Oelflecken / total },
            new() { Karte = "Tiefziehfehler", Anzahl = GesamtResult.Tiefziehfehler, Prozent = (double)GesamtResult.Tiefziehfehler / total },
            new() { Karte = "Fräsfehler", Anzahl = GesamtResult.Fraesfehler, Prozent = (double)GesamtResult.Fraesfehler / total },
            new() { Karte = "Knicke", Anzahl = GesamtResult.Knicke, Prozent = (double)GesamtResult.Knicke / total },
            new() { Karte = "Kratzer", Anzahl = GesamtResult.Kratzer, Prozent = (double)GesamtResult.Kratzer / total },
            new() { Karte = "Schlecht Intern", Anzahl = GesamtResult.SchlechtIntern, Prozent = (double)GesamtResult.SchlechtIntern / total }
        };

        ChartData = InterneFehler.Concat(ExterneFehler)
            .Where(x => !x.Karte.StartsWith("Schlecht") && x.Anzahl > 0)
            .OrderByDescending(x => x.Anzahl)
            .ToList();

        IsLoading = false;
    }

    private void ResetFilter()
    {
        SearchCharge = string.Empty;
        SelectedKunde = string.Empty;
        SelectedProjekt = string.Empty;
        SelectedArtikel = string.Empty;
        SelectedDekor = string.Empty;
        Projekte.Clear();
        ArtikelListe.Clear();
        DekorListe.Clear();

        var now = DateTime.Now;
        StartDatum = now;
        EndDatum = now;

        Eintraege.Clear();
        GesamtResult = new();
        ExterneFehler.Clear();
        InterneFehler.Clear();
        ChartData.Clear();
    }

    private async Task ExportData()
    {
        if (!Eintraege.Any())
        {
            await JS.InvokeVoidAsync("alert", "Keine Daten zum Exportieren vorhanden. Bitte wählen Sie zuerst Filter aus.");
            return;
        }

        IsLoading = true;
        StateHasChanged();
        await Task.Delay(50);

        var result = await AnalyseService.ExportToExcelAsync(Eintraege);

        IsLoading = false;
        StateHasChanged();

        await JS.InvokeVoidAsync("alert", result);
    }

    private IEnumerable<FehlerRow> SortString(Func<FehlerRow, string> selector)
    {
        return SortDescending
            ? Eintraege.OrderByDescending(selector, StringComparer.CurrentCultureIgnoreCase)
            : Eintraege.OrderBy(selector, StringComparer.CurrentCultureIgnoreCase);
    }

    private IEnumerable<FehlerRow> SortNumber(Func<FehlerRow, int> selector)
    {
        return SortDescending ? Eintraege.OrderByDescending(selector) : Eintraege.OrderBy(selector);
    }

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            SortDescending = !SortDescending;
            return;
        }

        SortColumn = column;
        SortDescending = true;
    }

    private string SortIcon(string column)
    {
        if (SortColumn != column)
        {
            return "fa-solid fa-sort sort-icon text-secondary";
        }

        return SortDescending
            ? "fa-solid fa-sort-down sort-icon text-primary"
            : "fa-solid fa-sort-up sort-icon text-primary";
    }

    private bool ApplyChartTheme(string? theme)
    {
        var normalizedTheme = string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase) ? "light" : "dark";
        if (normalizedTheme == CurrentTheme)
        {
            return false;
        }

        CurrentTheme = normalizedTheme;
        var isLight = CurrentTheme == "light";
        ChartOptions = CreateBarChartOptions(isLight);
        PieOptions = CreatePieChartOptions(isLight);
        return true;
    }

    private static ApexChartOptions<ChargeItem> CreateBarChartOptions(bool isLight)
    {
        return new ApexChartOptions<ChargeItem>
        {
            Theme = new Theme { Mode = isLight ? Mode.Light : Mode.Dark },
            Chart = new Chart
            {
                Background = isLight ? "#ffffff" : "#0f172a",
                ForeColor = isLight ? "#111827" : "#cbd5e1",
                FontFamily = "Inter, sans-serif"
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 6,
                    Horizontal = true
                }
            },
            Colors = new List<string> { "#2563eb" }
        };
    }

    private static ApexChartOptions<ChargeItem> CreatePieChartOptions(bool isLight)
    {
        return new ApexChartOptions<ChargeItem>
        {
            Theme = new Theme { Mode = isLight ? Mode.Light : Mode.Dark },
            Chart = new Chart
            {
                Background = isLight ? "#ffffff" : "#0f172a",
                ForeColor = isLight ? "#111827" : "#cbd5e1",
                FontFamily = "Inter, sans-serif"
            },
            Stroke = new Stroke { Show = false },
            Colors = new List<string>
            {
                "#2563eb",
                "#0ea5e9",
                "#14b8a6",
                "#10b981",
                "#f59e0b",
                "#f97316",
                "#ef4444"
            }
        };
    }

    private static string DisplayCount(int value) => value == 0 ? "-" : value.ToString();

    private static string TruncateText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value.Length > maxLength ? $"{value[..maxLength]}.." : value;
    }
}

