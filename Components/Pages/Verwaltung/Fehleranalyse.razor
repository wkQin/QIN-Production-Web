        : "0.00%";

    private string BadPercentage => GesamtResult.Gesamt > 0
        ? ((double)GesamtResult.Schlechtteile / GesamtResult.Gesamt).ToString("P2")
        : "0.00%";

    private bool HasContextFiltersWithoutArtikel =>
        !string.IsNullOrWhiteSpace(SearchCharge) ||
        !string.IsNullOrWhiteSpace(SelectedKunde) ||
        !string.IsNullOrWhiteSpace(SelectedProjekt) ||
        !string.IsNullOrWhiteSpace(SelectedDekor);

    private string SelectedDateRangeLabel =>
        StartDatum.Date == EndDatum.Date
            ? StartDatum.ToString("dd.MM.yyyy", DeCulture)
            : $"{StartDatum:dd.MM.yyyy} - {EndDatum:dd.MM.yyyy}";

    private string ProductionCompletionDisplay =>
        ProduktionszielAuswertung.Erfuellung.HasValue
            ? ProduktionszielAuswertung.Erfuellung.Value.ToString("P1", DeCulture)
            : "Kein Ziel";

    private string ProductionStatusValue =>
        ProduktionszielAuswertung.Ziel <= 0
            ? "Kein Ziel"
            : ProduktionszielAuswertung.Offen > 0
                ? $"Offen {FormatQuantity(ProduktionszielAuswertung.Offen)}"
                : $"Über Ziel {FormatQuantity(ProduktionszielAuswertung.UeberZiel)}";

    private string ProductionStatusClass =>
        ProduktionszielAuswertung.Ziel <= 0
            ? "is-neutral"
            : ProduktionszielAuswertung.Offen > 0
                ? "is-open"
                : "is-hit";

    private string ProductionProgressClass =>
        ProduktionszielAuswertung.Ziel <= 0
            ? "is-neutral"
            : ProduktionszielAuswertung.Offen > 0
                ? "is-open"
                : "is-hit";

    private string ProductionProgressMetaText =>
        ProduktionszielAuswertung.Ziel <= 0
            ? "Kein Ziel im Schichtplan"
            : ProduktionszielAuswertung.Offen > 0
                ? $"{FormatQuantity(ProduktionszielAuswertung.Offen)} Gutteile bis zum Ziel"
                : $"{FormatQuantity(ProduktionszielAuswertung.UeberZiel)} Gutteile über Ziel";

    private IEnumerable<FehlerRow> SortedEintraege => SortColumn switch
    {
        "Datum" => SortDescending ? Eintraege.OrderByDescending(x => x.FSKdate) : Eintraege.OrderBy(x => x.FSKdate),
        "Charge" => SortString(x => x.Charge),
        "Kunde" => SortString(x => x.Kunde),
        "Projekt" => SortString(x => x.Projekt),
        "Artikel" => SortString(x => x.Artikel),
        "Dekor" => SortString(x => x.Dekor),
        "Fusseln" => SortNumber(x => x.Fusseln),
        "Nadelstiche" => SortNumber(x => x.Nadelstiche),
        "Pickel" => SortNumber(x => x.Pickel),
        "Dekorfehler" => SortNumber(x => x.Dekorfehler),
        "Farbfehler" => SortNumber(x => x.Farbfehler),
        "Flecken" => SortNumber(x => x.Flecken),
        "Nebel" => SortNumber(x => x.Nebel),
        "Vertiefung" => SortNumber(x => x.Vertiefung),
        "Oelflecken" => SortNumber(x => x.Oelflecken),
        "Tiefziehfehler" => SortNumber(x => x.Tiefziehfehler),
        "Fraesfehler" => SortNumber(x => x.Fraesfehler),
        "Knicke" => SortNumber(x => x.Knicke),
        "Kratzer" => SortNumber(x => x.Kratzer),
        "Gutteile" => SortNumber(x => x.Gutteile),
        "Schlechtteile" => SortNumber(x => x.Schlechtteile),
        "Gesamt" => SortNumber(x => x.Gesamt),
        "Mitarbeiter" => SortString(x => x.PersonalName),
        "Bemerkung" => SortString(x => x.Bemerkungen),
        _ => Eintraege
    };

    protected override async Task OnInitializedAsync()
    {
        Kunden = await AnalyseService.GetKundenAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await JS.InvokeVoidAsync("makeTableResizable", EntriesTableId);

        ThemeReference = DotNetObjectReference.Create(this);
        ThemeSubscriptionId = await JS.InvokeAsync<string>("qinTheme.subscribe", ThemeReference);

        var theme = await JS.InvokeAsync<string>("qinTheme.getCurrent");
        if (ApplyChartTheme(theme))
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnThemeChanged(string theme)
    {
        if (ApplyChartTheme(theme))
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (!string.IsNullOrWhiteSpace(ThemeSubscriptionId))
        {
            try
            {
                await JS.InvokeVoidAsync("qinTheme.unsubscribe", ThemeSubscriptionId);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        ThemeReference?.Dispose();
    }

    private async Task OnKundeChanged(ChangeEventArgs e)
    {
        SelectedKunde = e.Value?.ToString() ?? string.Empty;
        SelectedProjekt = string.Empty;
        SelectedArtikel = string.Empty;
        SelectedDekor = string.Empty;
        Projekte = await AnalyseService.GetProjekteAsync(SelectedKunde);
        ArtikelListe.Clear();
        DekorListe.Clear();
        await TriggerAnalyseAsync();
    }

    private async Task OnProjektChanged(ChangeEventArgs e)
    {
        SelectedProjekt = e.Value?.ToString() ?? string.Empty;
        SelectedArtikel = string.Empty;
        SelectedDekor = string.Empty;
        var result = await AnalyseService.GetArtikelsAndDekorsAsync(SelectedProjekt);
        ArtikelListe = result.Artikels;
        DekorListe = result.Dekors;
        await TriggerAnalyseAsync();
    }

    private async Task TriggerAnalyseAsync()
    {
        AnalysePending = true;

        if (IsLoading)
        {
            return;
        }

        while (AnalysePending)
        {
            AnalysePending = false;
            await StartAnalyseAsync();
        }
    }

    private async Task StartAnalyseAsync()
    {
        IsLoading = true;
        StateHasChanged();

        await Task.Delay(50);

        Eintraege = await AnalyseService.GetRawFehlerRowsAsync(
            SearchCharge,
            SelectedKunde,
            SelectedProjekt,
            SelectedArtikel,
            SelectedDekor,
            StartDatum,
            EndDatum);

        MitarbeiterMaterialKombinationen = AnalyseService.GetMitarbeiterMaterialRows(Eintraege)
            .OrderByDescending(item => item.Schlechtteile)
            .ThenByDescending(item => item.Gesamt)
            .ThenBy(item => item.Mitarbeiter, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        GesamtResult = new FehlerAnalyseResult
        {
            Fusseln = Eintraege.Sum(x => x.Fusseln),
            Nadelstiche = Eintraege.Sum(x => x.Nadelstiche),
            Pickel = Eintraege.Sum(x => x.Pickel),
            Dekorfehler = Eintraege.Sum(x => x.Dekorfehler),
            Farbfehler = Eintraege.Sum(x => x.Farbfehler),
            Flecken = Eintraege.Sum(x => x.Flecken),
            Nebel = Eintraege.Sum(x => x.Nebel),
            Vertiefung = Eintraege.Sum(x => x.Vertiefung),
            Oelflecken = Eintraege.Sum(x => x.Oelflecken),
            Tiefziehfehler = Eintraege.Sum(x => x.Tiefziehfehler),
            Fraesfehler = Eintraege.Sum(x => x.Fraesfehler),
            Knicke = Eintraege.Sum(x => x.Knicke),
            Kratzer = Eintraege.Sum(x => x.Kratzer),
            Gutteile = Eintraege.Sum(x => x.Gutteile)
        };

        ProduktionszielAuswertung = await AnalyseService.GetProduktionszielAuswertungAsync(
            Eintraege,
            StartDatum,
            EndDatum,
            SelectedArtikel,
            HasContextFiltersWithoutArtikel);

        var total = GesamtResult.Gesamt == 0 ? 1 : GesamtResult.Gesamt;

        ExterneFehler = new List<ChargeItem>
        {
            new() { Karte = "Fusseln", Anzahl = GesamtResult.Fusseln, Prozent = (double)GesamtResult.Fusseln / total },
            new() { Karte = "Nadelstiche", Anzahl = GesamtResult.Nadelstiche, Prozent = (double)GesamtResult.Nadelstiche / total },
            new() { Karte = "Pickel", Anzahl = GesamtResult.Pickel, Prozent = (double)GesamtResult.Pickel / total },
            new() { Karte = "Dekorfehler", Anzahl = GesamtResult.Dekorfehler, Prozent = (double)GesamtResult.Dekorfehler / total },
            new() { Karte = "Farbfehler", Anzahl = GesamtResult.Farbfehler, Prozent = (double)GesamtResult.Farbfehler / total },
            new() { Karte = "Flecken", Anzahl = GesamtResult.Flecken, Prozent = (double)GesamtResult.Flecken / total },
            new() { Karte = "Nebel", Anzahl = GesamtResult.Nebel, Prozent = (double)GesamtResult.Nebel / total },
            new() { Karte = "Vertiefung", Anzahl = GesamtResult.Vertiefung, Prozent = (double)GesamtResult.Vertiefung / total },
            new() { Karte = "Schlecht Extern", Anzahl = GesamtResult.SchlechtExtern, Prozent = (double)GesamtResult.SchlechtExtern / total }
        };

        InterneFehler = new List<ChargeItem>
        {
            new() { Karte = "Ölflecken", Anzahl = GesamtResult.Oelflecken, Prozent = (double)GesamtResult.Oelflecken / total },
            new() { Karte = "Tiefziehfehler", Anzahl = GesamtResult.Tiefziehfehler, Prozent = (double)GesamtResult.Tiefziehfehler / total },
            new() { Karte = "Fräsfehler", Anzahl = GesamtResult.Fraesfehler, Prozent = (double)GesamtResult.Fraesfehler / total },
            new() { Karte = "Knicke", Anzahl = GesamtResult.Knicke, Prozent = (double)GesamtResult.Knicke / total },
            new() { Karte = "Kratzer", Anzahl = GesamtResult.Kratzer, Prozent = (double)GesamtResult.Kratzer / total },
            new() { Karte = "Schlecht Intern", Anzahl = GesamtResult.SchlechtIntern, Prozent = (double)GesamtResult.SchlechtIntern / total }
        };

        ChartData = InterneFehler.Concat(ExterneFehler)
            .Where(x => !x.Karte.StartsWith("Schlecht") && x.Anzahl > 0)
            .OrderByDescending(x => x.Anzahl)
            .ToList();

        IsLoading = false;
    }

    private void ResetFilter()
    {
        SearchCharge = string.Empty;
        SelectedKunde = string.Empty;
        SelectedProjekt = string.Empty;
        SelectedArtikel = string.Empty;
        SelectedDekor = string.Empty;
        Projekte.Clear();
        ArtikelListe.Clear();
        DekorListe.Clear();

        var now = DateTime.Now;
        StartDatum = now;
        EndDatum = now;

        Eintraege.Clear();
        MitarbeiterMaterialKombinationen.Clear();
        GesamtResult = new();
        ProduktionszielAuswertung = new();
        ExterneFehler.Clear();
        InterneFehler.Clear();
        ChartData.Clear();
    }

    private async Task ExportData()
    {
        if (!Eintraege.Any())
        {
            await JS.InvokeVoidAsync("alert", "Keine Daten zum Exportieren vorhanden. Bitte wählen Sie zuerst Filter aus.");
            return;
        }

        IsLoading = true;
        StateHasChanged();
        await Task.Delay(50);

        var result = await AnalyseService.ExportToExcelAsync(new FehleranalyseExportRequest
        {
            Eintraege = Eintraege,
            StartDatum = StartDatum,
            EndDatum = EndDatum,
            Charge = SearchCharge,
            Kunde = SelectedKunde,
            Projekt = SelectedProjekt,
            Artikel = SelectedArtikel,
            Dekor = SelectedDekor,
            ProduktionszielAuswertung = ProduktionszielAuswertung
        });

        IsLoading = false;
        StateHasChanged();

        if (!result.Success)
        {
            await JS.InvokeVoidAsync("alert", result.ErrorMessage ?? "Der Export konnte nicht erstellt werden.");
            return;
        }

        using var streamRef = new DotNetStreamReference(stream: new MemoryStream(result.Content));
        await JS.InvokeVoidAsync("downloadFileFromStream", result.FileName, streamRef);
    }

    private IEnumerable<FehlerRow> SortString(Func<FehlerRow, string> selector)
    {
        return SortDescending
            ? Eintraege.OrderByDescending(selector, StringComparer.CurrentCultureIgnoreCase)
            : Eintraege.OrderBy(selector, StringComparer.CurrentCultureIgnoreCase);
    }

    private IEnumerable<FehlerRow> SortNumber(Func<FehlerRow, int> selector)
    {
        return SortDescending ? Eintraege.OrderByDescending(selector) : Eintraege.OrderBy(selector);
    }

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            SortDescending = !SortDescending;
            return;
        }

        SortColumn = column;
        SortDescending = true;
    }

    private string SortIcon(string column)
    {
        if (SortColumn != column)
        {
            return "fa-solid fa-sort sort-icon text-secondary";
        }

        return SortDescending
            ? "fa-solid fa-sort-down sort-icon text-primary"
            : "fa-solid fa-sort-up sort-icon text-primary";
    }

    private bool ApplyChartTheme(string? theme)
    {
        var normalizedTheme = string.Equals(theme, "light", StringComparison.OrdinalIgnoreCase) ? "light" : "dark";
        if (normalizedTheme == CurrentTheme)
        {
            return false;
        }

        CurrentTheme = normalizedTheme;
        var isLight = CurrentTheme == "light";
        ChartOptions = CreateBarChartOptions(isLight);
        PieOptions = CreatePieChartOptions(isLight);
        return true;
    }

    private static ApexChartOptions<ChargeItem> CreateBarChartOptions(bool isLight)
    {
        return new ApexChartOptions<ChargeItem>
        {
            Theme = new Theme { Mode = isLight ? Mode.Light : Mode.Dark },
            Chart = new Chart
            {
                Background = isLight ? "#ffffff" : "#0f172a",
                ForeColor = isLight ? "#111827" : "#cbd5e1",
                FontFamily = "Inter, sans-serif"
            },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 6,
                    Horizontal = true
                }
            },
            Colors = new List<string> { "#2563eb" }
        };
    }

    private static ApexChartOptions<ChargeItem> CreatePieChartOptions(bool isLight)
    {
        return new ApexChartOptions<ChargeItem>
        {
            Theme = new Theme { Mode = isLight ? Mode.Light : Mode.Dark },
            Chart = new Chart
            {
                Background = isLight ? "#ffffff" : "#0f172a",
                ForeColor = isLight ? "#111827" : "#cbd5e1",
                FontFamily = "Inter, sans-serif"
            },
            Stroke = new Stroke { Show = false },
            Colors = new List<string>
            {
                "#2563eb",
                "#0ea5e9",
                "#14b8a6",
                "#10b981",
                "#f59e0b",
                "#f97316",
                "#ef4444"
            }
        };
    }

    private static string DisplayCount(int value) => value == 0 ? "-" : value.ToString();

    private string GetGoalProgressStyle()
    {
        var progress = ProduktionszielAuswertung.Erfuellung ?? 0d;
        var width = Math.Clamp(progress, 0d, 1d) * 100d;
        return $"width: {width.ToString("0.#", CultureInfo.InvariantCulture)}%;";
    }

    private static string FormatQuantity(int value) => value.ToString("N0", DeCulture);

    private static string FormatPercent(double value) => value.ToString("P2", DeCulture);

    private static string BuildMaterialLabel(FehleranalyseMitarbeiterMaterialRow item)
    {
        if (string.IsNullOrWhiteSpace(item.Artikel) || item.Artikel == "-")
        {
            return "-";
        }

        var artikel = item.Artikel.Trim();
        if (!string.IsNullOrWhiteSpace(item.Projekt) && item.Projekt != "-")
        {
            var index = artikel.IndexOf(item.Projekt, StringComparison.CurrentCultureIgnoreCase);
            if (index >= 0)
            {
                var material = artikel[index..].Trim();
                if (!string.IsNullOrWhiteSpace(material))
                {
                    return material;
                }
            }
        }

        return artikel;
    }

    private static string BuildMaterialTooltip(FehleranalyseMitarbeiterMaterialRow item)
    {
        return $"Kunde: {item.Kunde} | Projekt: {item.Projekt} | Artikel: {item.Artikel} | Dekor: {item.Dekor}";
    }

    private static string GetMaterialStatusText(FehleranalyseZielDetail detail)
    {
        if (detail.Ziel <= 0)
        {
            return "Kein Ziel";
        }

        if (detail.Offen > 0)
        {
            return $"Offen {FormatQuantity(detail.Offen)}";
        }

        return $"Über Ziel {FormatQuantity(detail.UeberZiel)}";
    }

    private static string GetMaterialStatusClass(FehleranalyseZielDetail detail)
    {
        if (detail.Ziel <= 0)
        {
            return "is-neutral";
        }

        return detail.Offen > 0 ? "is-open" : "is-hit";
    }

    private static string TruncateText(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value.Length > maxLength ? $"{value[..maxLength]}.." : value;
    }
}

