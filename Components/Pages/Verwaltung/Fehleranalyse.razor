@page "/verwaltung/fehleranalyse"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using ApexCharts
@using System.IO
@using System.Globalization
@using Microsoft.JSInterop
@using QIN_Production_Web.Data
@inject FehleranalyseService AnalyseService
@inject IJSRuntime JS

<PageTitle>Fehleranalyse - Verwaltung</PageTitle>

<div class="fehleranalyse-page qin-page-shell pb-3">

    <div class="row g-3 mb-3 align-items-stretch">
        <div class="col-xl-3 col-lg-4">
            <div class="glass-card qin-panel d-flex flex-column h-100">
                <div class="card-title-modern d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-filter text-primary"></i>
                        <span>Filter</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="qin-badge fehleranalyse-status-badge @(HasResults ? "qin-badge-info" : "qin-badge-neutral")">
                            <i class="fa-solid @(IsLoading ? "fa-spinner fa-spin" : HasResults ? "fa-chart-line" : "fa-circle-check")"></i>
                            @(IsLoading ? "Lädt..." : HasResults ? $"{Eintraege.Count}" : "Bereit")
                        </span>
                        <button class="btn qin-btn-ghost btn-sm fehleranalyse-filter-reset" title="Filter zurücksetzen" @onclick="ResetFilter">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="modern-label">Charge</label>
                        <div class="qin-input-shell">
                            <i class="fa-solid fa-barcode qin-input-icon"></i>
                            <input type="text"
                                   class="form-control qin-input"
                                   placeholder="Charge suchen..."
                                   @bind="SearchCharge"
                                   @bind:after="TriggerAnalyseAsync" />
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="modern-label">Kunde</label>
                        <select class="form-select modern-select" value="@SelectedKunde" @onchange="OnKundeChanged">
                            <option value="">Alle Kunden</option>
                            @foreach (var kunde in Kunden)
                            {
                                <option value="@kunde.Name" style="@(kunde.IsActive ? null : "color: var(--text-secondary); font-style: italic;")">
                                    @kunde.Name @(kunde.IsActive ? string.Empty : "(Inaktiv)")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="modern-label">Projekt</label>
                        <select class="form-select modern-select" value="@SelectedProjekt" @onchange="OnProjektChanged">
                            <option value="">Alle Projekte</option>
                            @foreach (var projekt in Projekte)
                            {
                                <option value="@projekt">@projekt</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="modern-label">Artikel</label>
                        <select class="form-select modern-select" @bind="SelectedArtikel" @bind:after="TriggerAnalyseAsync">
                            <option value="">Alle Artikel</option>
                            @foreach (var artikel in ArtikelListe)
                            {
                                <option value="@artikel">@artikel</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="modern-label">Dekor</label>
                        <select class="form-select modern-select" @bind="SelectedDekor" @bind:after="TriggerAnalyseAsync">
                            <option value="">Alle Dekore</option>
                            @foreach (var dekor in DekorListe)
                            {
                                <option value="@dekor">@dekor</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <label class="modern-label">Datum von</label>
                        <input type="date" class="form-control modern-input" @bind="StartDatum" @bind:after="TriggerAnalyseAsync" />
                    </div>
                    <div class="col-6">
                        <label class="modern-label">Datum bis</label>
                        <input type="date" class="form-control modern-input" @bind="EndDatum" @bind:after="TriggerAnalyseAsync" />
                    </div>
                </div>

            </div>
        </div>

        <div class="col-xl-9 col-lg-8">
            <div class="glass-card qin-panel d-flex flex-column h-100 fehleranalyse-results-panel">
                <ul class="qin-tab-nav" role="tablist">
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "gesamt" ? "active" : null)" @onclick='() => ActiveTab = "gesamt"'>Gesamt</button>
                    </li>
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "eintraege" ? "active" : null)" @onclick='() => ActiveTab = "eintraege"'>Einzelne Einträge</button>
                    </li>
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "bar" ? "active" : null)" @onclick='() => ActiveTab = "bar"'>Balkendiagramm</button>
                    </li>
                    <li class="nav-item">
                        <button class="qin-tab-btn @(ActiveTab == "pie" ? "active" : null)" @onclick='() => ActiveTab = "pie"'>Tortendiagramm</button>
                    </li>
                </ul>

                <div class="fehleranalyse-tab-content">
                    <div class="@(ActiveTab == "gesamt" ? string.Empty : "d-none")">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <h5 class="fehleranalyse-section-title">
                                    <i class="fa-solid fa-arrow-right-from-bracket text-primary me-2"></i>Externe Fehler
                                </h5>
                                <div class="modern-table-container qin-table-shell">
                                    <table class="modern-table qin-table">
                                        <thead>
                                            <tr>
                                                <th>Karte Extern</th>
                                                <th class="text-end">Anzahl</th>
                                                <th class="text-end">Prozent</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!ExterneFehler.Any())
                                            {
                                                <tr>
                                                    <td colspan="3" class="qin-empty-state">Wählen Sie Filter aus, um Daten zu laden.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in ExterneFehler)
                                                {
                                                    <tr class="@(item.Karte.StartsWith("Schlecht") ? "fehleranalyse-emphasis-row" : null)">
                                                        <td>@item.Karte</td>
                                                        <td class="text-end">@item.Anzahl</td>
                                                        <td class="text-end">@(item.Prozent?.ToString("P2"))</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h5 class="fehleranalyse-section-title">
                                    <i class="fa-solid fa-arrow-right-to-bracket text-primary me-2"></i>Interne Fehler
                                </h5>
                                <div class="modern-table-container qin-table-shell">
                                    <table class="modern-table qin-table">
                                        <thead>
                                            <tr>
                                                <th>Karte Intern</th>
                                                <th class="text-end">Anzahl</th>
                                                <th class="text-end">Prozent</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!InterneFehler.Any())
                                            {
                                                <tr>
                                                    <td colspan="3" class="qin-empty-state">Wählen Sie Filter aus, um Daten zu laden.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in InterneFehler)
                                                {
                                                    <tr class="@(item.Karte.StartsWith("Schlecht") ? "fehleranalyse-emphasis-row" : null)">
                                                        <td>@item.Karte</td>
                                                        <td class="text-end">@item.Anzahl</td>
                                                        <td class="text-end">@(item.Prozent?.ToString("P2"))</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="qin-stat-grid mt-4 fehleranalyse-summary-grid">
                            <div class="qin-stat-card fehleranalyse-stat-card fehleranalyse-summary-card fehleranalyse-stat-card-good">
                                <span class="modern-label d-block mb-2 text-success">Gutteile</span>
                                <span class="qin-stat-card-value">
                                    @FormatQuantity(GesamtResult.Gutteile)
                                    <small class="qin-stat-card-subvalue">(@GoodPercentage)</small>
                                </span>
                            </div>
                            <div class="qin-stat-card fehleranalyse-stat-card fehleranalyse-summary-card fehleranalyse-stat-card-bad">
                                <span class="modern-label d-block mb-2 text-danger">Schlechtteile</span>
                                <span class="qin-stat-card-value">
                                    @FormatQuantity(GesamtResult.Schlechtteile)
                                    <small class="qin-stat-card-subvalue">(@BadPercentage)</small>
                                </span>
                            </div>
                            <div class="qin-stat-card fehleranalyse-stat-card fehleranalyse-summary-card fehleranalyse-stat-card-total">
                                <span class="modern-label d-block mb-2 text-primary">Gesamt</span>
                                <span class="qin-stat-card-value">
                                    @FormatQuantity(GesamtResult.Gesamt)
                                    <small class="qin-stat-card-subvalue">@Eintraege.Count Karten</small>
                                </span>
                            </div>
                        </div>

                        <section class="fehleranalyse-goal-shell mt-4">
                            <div class="fehleranalyse-goal-head">
                                <span class="fehleranalyse-goal-kicker">Zielabgleich</span>

                                <div class="fehleranalyse-goal-head-meta">
                                    <span class="qin-badge qin-badge-info">@SelectedDateRangeLabel</span>
                                    <span class="fehleranalyse-goal-mini-pill text-info">Ziel @FormatQuantity(ProduktionszielAuswertung.Ziel)</span>
                                    <span class="@($"fehleranalyse-goal-mini-pill {ProductionStatusClass}")">@ProductionStatusValue</span>
                                    <span class="fehleranalyse-goal-mini-pill text-success">@ProductionCompletionDisplay</span>
                                </div>
                            </div>

                            <div class="fehleranalyse-goal-progress-panel">
                                <div class="fehleranalyse-goal-progress-track">
                                    <div class="@($"fehleranalyse-goal-progress-bar {ProductionProgressClass}")" style="@GetGoalProgressStyle()"></div>
                                </div>
                                <div class="fehleranalyse-goal-progress-meta">
                                    <span>Gut @FormatQuantity(ProduktionszielAuswertung.GutteileMitZiel)</span>
                                    <span>@ProductionProgressMetaText</span>
                                </div>
                            </div>

                            <div class="fehleranalyse-goal-detail-shell">
                                @if (!ProduktionszielAuswertung.Details.Any())
                                {
                                    <div class="qin-empty-state fehleranalyse-goal-empty">
                                        Für den gewählten Zeitraum gibt es noch keine kombinierbaren Ziel- oder Produktionsdaten.
                                    </div>
                                }
                                else
                                {
                                    <div class="modern-table-container qin-table-shell">
                                        <table class="modern-table qin-table fehleranalyse-goal-table">
                                            <thead>
                                                <tr>
                                                    <th>Material</th>
                                                    <th class="text-end">Gutteile</th>
                                                    <th class="text-end">Ziel</th>
                                                    <th class="text-end">Schlechtteile</th>
                                                    <th class="text-end">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var detail in ProduktionszielAuswertung.Details)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@detail.Material</td>
                                                        <td class="text-end text-success fw-bold">@FormatQuantity(detail.Gutteile)</td>
                                                        <td class="text-end text-info fw-bold">@FormatQuantity(detail.Ziel)</td>
                                                        <td class="text-end text-danger fw-bold">@FormatQuantity(detail.Schlechtteile)</td>
                                                        <td class="text-end">
                                                            <span class="@($"fehleranalyse-goal-status-pill {GetMaterialStatusClass(detail)}")">
                                                                @GetMaterialStatusText(detail)
                                                            </span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </section>

                        <div class="fehleranalyse-export-row mt-4">
                            <button class="btn qin-btn-ghost fehleranalyse-export-button" @onclick="ExportData" disabled="@(!Eintraege.Any() || IsLoading)">
                                <i class="fa-solid fa-file-excel text-success me-2"></i> Export
                            </button>
                        </div>
                    </div>

                    <div class="@(ActiveTab == "eintraege" ? string.Empty : "d-none")">
                        <div class="fehleranalyse-export-row fehleranalyse-export-row-entries">
                            <button class="btn qin-btn-ghost fehleranalyse-export-button" @onclick="ExportData" disabled="@(!Eintraege.Any() || IsLoading)">
                                <i class="fa-solid fa-file-excel text-success me-2"></i> Export
                            </button>
                        </div>

                        <div class="modern-table-container qin-table-shell fehleranalyse-entries-shell">
                            <table id="fehleranalyse-eintraege-table" class="modern-table qin-table entries-grid fehleranalyse-entries-table">
                                <thead>
                                    <tr>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Datum")'><span>Datum</span><i class="@SortIcon("Datum")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Charge")'><span>Charge</span><i class="@SortIcon("Charge")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Kunde")'><span>Kunde</span><i class="@SortIcon("Kunde")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Projekt")'><span>Projekt</span><i class="@SortIcon("Projekt")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Artikel")'><span>Artikel</span><i class="@SortIcon("Artikel")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Dekor")'><span>Dekor</span><i class="@SortIcon("Dekor")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Fusseln")'><span>Fus.</span><i class="@SortIcon("Fusseln")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Nadelstiche")'><span>Nad.</span><i class="@SortIcon("Nadelstiche")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Pickel")'><span>Pic.</span><i class="@SortIcon("Pickel")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Dekorfehler")'><span>Dek.</span><i class="@SortIcon("Dekorfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Farbfehler")'><span>Far.</span><i class="@SortIcon("Farbfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Flecken")'><span>Fle.</span><i class="@SortIcon("Flecken")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Nebel")'><span>Neb.</span><i class="@SortIcon("Nebel")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Vertiefung")'><span>Ver.</span><i class="@SortIcon("Vertiefung")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Oelflecken")'><span>Öl</span><i class="@SortIcon("Oelflecken")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Tiefziehfehler")'><span>Tie.</span><i class="@SortIcon("Tiefziehfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Fraesfehler")'><span>Frä.</span><i class="@SortIcon("Fraesfehler")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Knicke")'><span>Kni.</span><i class="@SortIcon("Knicke")"></i></th>
                                        <th class="sortable-resizable-header text-center" @onclick='() => SortBy("Kratzer")'><span>Kra.</span><i class="@SortIcon("Kratzer")"></i></th>
                                        <th class="sortable-resizable-header text-success text-end" @onclick='() => SortBy("Gutteile")'><span>Gut</span><i class="@SortIcon("Gutteile")"></i></th>
                                        <th class="sortable-resizable-header text-danger text-end" @onclick='() => SortBy("Schlechtteile")'><span>Schl.</span><i class="@SortIcon("Schlechtteile")"></i></th>
                                        <th class="sortable-resizable-header text-primary text-end" @onclick='() => SortBy("Gesamt")'><span>Ges.</span><i class="@SortIcon("Gesamt")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Mitarbeiter")'><span>Mitarbeiter</span><i class="@SortIcon("Mitarbeiter")"></i></th>
                                        <th class="sortable-resizable-header" @onclick='() => SortBy("Bemerkung")'><span>Bemerkung</span><i class="@SortIcon("Bemerkung")"></i></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Eintraege.Any())
                                    {
                                        <tr>
                                            <td colspan="24" class="qin-empty-state">Keine Datensätze gefunden.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var row in SortedEintraege)
                                        {
                                            <tr>
                                                <td>@row.FSKdate.ToString("dd.MM.yyyy")</td>
                                                <td class="fw-bold">@row.Charge</td>
                                                <td title="@row.Kunde">@TruncateText(row.Kunde, 10)</td>
                                                <td title="@row.Projekt">@TruncateText(row.Projekt, 10)</td>
                                                <td title="@row.Artikel">@TruncateText(row.Artikel, 15)</td>
                                                <td>@row.Dekor</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Fusseln)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Nadelstiche)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Pickel)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Dekorfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Farbfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Flecken)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Nebel)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Vertiefung)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Oelflecken)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Tiefziehfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Fraesfehler)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Knicke)</td>
                                                <td class="text-center text-secondary">@DisplayCount(row.Kratzer)</td>
                                                <td class="text-success text-end fw-bold">@row.Gutteile</td>
                                                <td class="text-danger text-end fw-bold">@row.Schlechtteile</td>
                                                <td class="text-primary text-end fw-bold">@row.Gesamt</td>
                                                <td class="text-info fw-bold">@row.PersonalName</td>
                                                <td title="@row.Bemerkungen" class="fehleranalyse-note-cell">
                                                    @(string.IsNullOrWhiteSpace(row.Bemerkungen) ? "-" : row.Bemerkungen)
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4">
                            <h5 class="fehleranalyse-section-title">
                                <i class="fa-solid fa-layer-group text-primary me-2"></i>Benutzer und Material kombiniert
                            </h5>

                            <div class="modern-table-container qin-table-shell">
                                <table class="modern-table qin-table">
                                    <thead>
                                        <tr>
                                            <th>Benutzer</th>
                                            <th>Material</th>
                                            <th class="text-end">Einträge</th>
                                            <th class="text-end text-success">Gut</th>
                                            <th class="text-end text-danger">Schlecht extern</th>
                                            <th class="text-end text-danger">Schlecht intern</th>
                                            <th class="text-end text-danger">Schlechtteile</th>
                                            <th class="text-end text-primary">Gesamt</th>
                                            <th class="text-end">Schlecht %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!MitarbeiterMaterialKombinationen.Any())
                                        {
                                            <tr>
                                                <td colspan="9" class="qin-empty-state">Keine kombinierten Werte vorhanden.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in MitarbeiterMaterialKombinationen)
                                            {
                                                <tr>
                                                    <td class="fw-semibold text-info">@item.Mitarbeiter</td>
                                                    <td title="@BuildMaterialTooltip(item)">@BuildMaterialLabel(item)</td>
                                                    <td class="text-end">@FormatQuantity(item.Eintraege)</td>
                                                    <td class="text-end text-success fw-bold">@FormatQuantity(item.Gutteile)</td>
                                                    <td class="text-end">@FormatQuantity(item.SchlechtExtern)</td>
                                                    <td class="text-end">@FormatQuantity(item.SchlechtIntern)</td>
                                                    <td class="text-end text-danger fw-bold">@FormatQuantity(item.Schlechtteile)</td>
                                                    <td class="text-end text-primary fw-bold">@FormatQuantity(item.Gesamt)</td>
                                                    <td class="text-end">@FormatPercent(item.Ausschussquote)</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="fehleranalyse-chart-pane @(ActiveTab == "bar" ? string.Empty : "d-none")">
                        @if (!ChartData.Any())
                        {
                            <div class="qin-empty-state">Keine Datensätze gefunden.</div>
                        }
                        else
                        {
                            <div class="fehleranalyse-chart-card">
                                <ApexChart @key="CurrentTheme" TItem="ChargeItem" Options="@ChartOptions" Height="500">
                                    <ApexPointSeries TItem="ChargeItem"
                                                     Items="ChartData"
                                                     Name="Fehleranzahl"
                                                     SeriesType="SeriesType.Bar"
                                                     XValue="@(e => e.Karte)"
                                                     YValue="@(e => (decimal?)e.Anzahl)" />
                                </ApexChart>
                            </div>
                        }
                    </div>

                    <div class="fehleranalyse-chart-pane fehleranalyse-chart-pane-compact @(ActiveTab == "pie" ? string.Empty : "d-none")">
                        @if (!ChartData.Any())
                        {
                            <div class="qin-empty-state">Keine Datensätze gefunden.</div>
                        }
                        else
                        {
                            <div class="fehleranalyse-donut-shell">
                                <ApexChart @key="CurrentTheme" TItem="ChargeItem" Options="@PieOptions" Height="400">
                                    <ApexPointSeries TItem="ChargeItem"
                                                     Items="ChartData"
                                                     Name="Verteilung"
                                                     SeriesType="SeriesType.Donut"
                                                     XValue="@(e => e.Karte)"
                                                     YAggregate="@(e => (decimal?)e.Sum(x => x.Anzahl))" />
                                </ApexChart>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private const string EntriesTableId = "fehleranalyse-eintraege-table";

    private string ActiveTab = "gesamt";
    private string SearchCharge = string.Empty;
    private string SelectedKunde = string.Empty;
    private string SelectedProjekt = string.Empty;
    private string SelectedArtikel = string.Empty;
    private string SelectedDekor = string.Empty;
    private string CurrentTheme = "dark";
    private static readonly CultureInfo DeCulture = CultureInfo.GetCultureInfo("de-DE");
    private DateTime StartDatum = DateTime.Now;
