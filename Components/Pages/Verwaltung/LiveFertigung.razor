    private static readonly IReadOnlyList<EndkontrolleTableTestData> RoomOneLeftStations =
    [
        EndkontrolleStationsByTable[3],
        EndkontrolleStationsByTable[2],
        EndkontrolleStationsByTable[1]
    ];

    private static readonly IReadOnlyList<EndkontrolleTableTestData> RoomOneRightStations =
    [
        EndkontrolleStationsByTable[5],
        EndkontrolleStationsByTable[6],
        EndkontrolleStationsByTable[7],
        EndkontrolleStationsByTable[8]
    ];

    private static readonly IReadOnlyList<EndkontrolleTableTestData> RoomTwoStations =
    [
        EndkontrolleStationsByTable[9],
        EndkontrolleStationsByTable[10],
        EndkontrolleStationsByTable[11],
        EndkontrolleStationsByTable[12]
    ];

    private LiveAreaTab ActiveArea => Areas.FirstOrDefault(area => area.Key == ActiveAreaKey) ?? Areas[0];

    private void SelectArea(string areaKey)
    {
        ActiveAreaKey = areaKey;
    }

    private string GetTabButtonClass(string areaKey) =>
        areaKey == ActiveAreaKey
            ? "live-fertigung-tab-btn is-active"
            : "live-fertigung-tab-btn";

    private static string GetEndkontrolleTableClass(EndkontrolleTableTestData station) =>
        station.IsOccupied
            ? "endkontrolle-table-card is-occupied"
            : "endkontrolle-table-card is-free";

    private static int GetProgressPercent(EndkontrolleTableTestData station) =>
        station.TargetQuantity > 0
            ? Math.Clamp((int)Math.Round(station.DoneQuantity / (double)station.TargetQuantity * 100), 0, 140)
            : 0;

    private static string GetProgressStyle(EndkontrolleTableTestData station) =>
        $"width:{Math.Min(GetProgressPercent(station), 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    private static RenderFragment RenderEndkontrolleTable(EndkontrolleTableTestData station) => @<div class="endkontrolle-table-station">
        <div class="@GetEndkontrolleTableClass(station)">
            <div class="endkontrolle-table-topline">
                <span class="endkontrolle-table-label">Tisch @station.TableNumber</span>
                <span class="endkontrolle-table-state">
                    <span class="endkontrolle-table-state-dot"></span>
                    @(station.IsOccupied ? "belegt" : "frei")
                </span>
            </div>

            <div class="endkontrolle-table-main">
                <strong>@(station.IsOccupied ? station.User : "Nicht besetzt")</strong>
                @if (station.Materials.Count == 0)
                {
                    <span class="endkontrolle-material-empty">Keine Zuweisung</span>
                }
                else
                {
                    <div class="endkontrolle-material-stack">
                        @foreach (var material in station.Materials)
                        {
                            <span>@material</span>
                        }
                    </div>
                }
            </div>

            <div class="endkontrolle-table-metrics">
                <div>
                    <span>Menge</span>
                    <strong>@station.DoneQuantity</strong>
                </div>
                <div>
                    <span>Ziel</span>
                    <strong>@(station.TargetQuantity > 0 ? station.TargetQuantity : "-")</strong>
                </div>
            </div>

            <div class="endkontrolle-table-progress">
                <span style="@GetProgressStyle(station)"></span>
            </div>
        </div>

        <div class="endkontrolle-table-actions">
            <div class="endkontrolle-hover-action">
                <button type="button" class="endkontrolle-icon-btn" aria-label="Heutige Einträge anzeigen">
                    <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                    <span class="endkontrolle-icon-tooltip">Heutige Einträge</span>
                </button>
                <div class="endkontrolle-hover-panel">
                    <div class="endkontrolle-hover-head">
                        <strong>Tisch @station.TableNumber: Heutige Einträge</strong>
                        <span>@station.TodayEntries.Count Einträge</span>
                    </div>
                    <div class="endkontrolle-hover-legend">
                        <span class="text-success">Gut</span>
                        <span class="text-danger">Schlecht</span>
                    </div>
                    @if (station.TodayEntries.Count == 0)
                    {
                        <div class="endkontrolle-hover-empty">Keine Einträge</div>
                    }
                    else
                    {
                        @foreach (var entry in station.TodayEntries)
                        {
                            <div class="endkontrolle-hover-row">
                                <div>
                                    <strong>@entry.Time</strong>
                                    <span>@entry.Material</span>
                                    <small>@entry.Charge</small>
                                </div>
                                <div class="endkontrolle-hover-values">
                                    <span class="text-success">@entry.Good</span>
                                    <span class="text-danger">@entry.Bad</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="endkontrolle-hover-action">
                <button type="button" class="endkontrolle-icon-btn" aria-label="Letzte Tage anzeigen">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                    <span class="endkontrolle-icon-tooltip">Letzte Tage</span>
                </button>
                <div class="endkontrolle-hover-panel is-history">
                    <div class="endkontrolle-hover-head">
                        <strong>Tisch @station.TableNumber: Letzte Tage</strong>
                        <span>Menge / Ziel</span>
                    </div>
                    <div class="endkontrolle-hover-legend">
                        <span>Datum</span>
                        <span>Menge / Ziel</span>
                    </div>
                    @if (station.HistoryEntries.Count == 0)
                    {
                        <div class="endkontrolle-hover-empty">Keine Historie</div>
                    }
                    else
                    {
                        @foreach (var entry in station.HistoryEntries)
                        {
                            <div class="endkontrolle-hover-row">
                                <div>
                                    <strong>@entry.Date</strong>
                                    <span>@entry.Material</span>
                                </div>
                                <div class="endkontrolle-hover-values">
                                    <span>@entry.Done</span>
                                    <small>/ @entry.Target</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>;

    private sealed record LiveAreaTab(
        string Key,
        string Label,
        string Icon,
        string ShortDescription,
        string Description,
        string PrimaryFocusTitle,
        string PrimaryFocusText);

    private sealed record EndkontrolleTableTestData(
        int TableNumber,
        bool IsOccupied,
        string User,
        IReadOnlyList<string> Materials,
        int DoneQuantity,
        int TargetQuantity,
        IReadOnlyList<EndkontrolleTodayEntry> TodayEntries,
        IReadOnlyList<EndkontrolleHistoryEntry> HistoryEntries);

    private sealed record EndkontrolleTodayEntry(
        string Time,
        string Material,
        string Charge,
        int Good,
        int Bad,
        string Note);

    private sealed record EndkontrolleHistoryEntry(
        string Date,
        string Material,
        int Done,
        int Target);
}
