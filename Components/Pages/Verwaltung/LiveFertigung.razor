@page "/verwaltung/live-fertigung"
@attribute [Authorize(Roles = "Admin,Verwaltung")]
@inject LiveFertigungService LiveFertigungService

<PageTitle>Live-Fertigung - Verwaltung</PageTitle>

<div class="qin-page-shell live-fertigung-page pb-4">
    <section class="glass-card qin-panel live-fertigung-hero">
        <div class="live-fertigung-title-row">
            <span class="live-fertigung-live-dot" aria-hidden="true"></span>
            <h2 class="live-fertigung-title mb-0">Live-Fertigung</h2>
        </div>
    </section>

    <section class="glass-card qin-panel live-fertigung-tabs-panel">
        <div class="live-fertigung-tabs-strip" role="tablist" aria-label="Produktionsbereiche">
            @foreach (var area in Areas)
            {
                <button type="button"
                        role="tab"
                        class="@GetTabButtonClass(area.Key)"
                        aria-selected="@(ActiveAreaKey == area.Key)"
                        @onclick="@(() => SelectArea(area.Key))">
                    <i class="@area.Icon" aria-hidden="true"></i>
                    <span>@area.Label</span>
                </button>
            }
        </div>
    </section>

    <section class="glass-card qin-panel live-fertigung-content-panel">
        <div class="live-fertigung-content-head live-fertigung-content-head-compact">
            <div>
                <h3 class="card-title-modern mb-0">@ActiveArea.Label</h3>
            </div>

            @if (ActiveAreaKey == "Endkontrolle")
            {
                <span class="live-fertigung-priority-badge">Live-Daten</span>
            }
        </div>

        @if (ActiveAreaKey == EndkontrolleAreaKey)
        {
            <div class="endkontrolle-live-shell">
                <div class="endkontrolle-layout-stage">
                    <section class="endkontrolle-room endkontrolle-room-one" aria-label="Raum 1">
                        <span class="endkontrolle-room-label">Raum 1</span>

                        <div class="endkontrolle-room-column endkontrolle-room-column-left">
                            @foreach (var tableNumber in RoomOneLeftTables)
                            {
                                @RenderEndkontrolleTable(GetEndkontrolleStation(tableNumber))
                            }
                        </div>

                        <div class="endkontrolle-top-station">
                            @RenderEndkontrolleTable(GetEndkontrolleStation(4))
                        </div>

                        <div class="endkontrolle-room-column endkontrolle-room-column-right">
                            @foreach (var tableNumber in RoomOneRightTables)
                            {
                                @RenderEndkontrolleTable(GetEndkontrolleStation(tableNumber))
                            }
                        </div>
                    </section>

                    <section class="endkontrolle-room endkontrolle-room-two" aria-label="Raum 2">
                        <span class="endkontrolle-room-label">Raum 2</span>

                        <div class="endkontrolle-room-column endkontrolle-room-column-left">
                            @foreach (var tableNumber in RoomTwoTables)
                            {
                                @RenderEndkontrolleTable(GetEndkontrolleStation(tableNumber))
                            }
                        </div>
                    </section>
                </div>
            </div>
        }
        else
        {
            <div class="live-fertigung-placeholder-grid">
                <article class="live-fertigung-placeholder-card is-primary">
                    <span class="modern-label">Geplanter Inhalt</span>
                    <h4>@ActiveArea.PrimaryFocusTitle</h4>
                    <p class="mb-0">@ActiveArea.PrimaryFocusText</p>
                </article>

                <article class="live-fertigung-placeholder-card">
                    <span class="modern-label">Nächster Schritt</span>
                    <h4>Live-Daten anbinden</h4>
                    <p class="mb-0">
                        Für diesen Bereich wird im nächsten Ausbauschritt die echte Belegung, Menge und Zielmenge auf die Seite gebracht.
                    </p>
                </article>

                <article class="live-fertigung-placeholder-card">
                    <span class="modern-label">Später geplant</span>
                    <h4>Hover-Details</h4>
                    <p class="mb-0">
                        Ein zusätzlicher Hover- oder Info-Button soll später auch ältere und bereits fertige Informationen direkt im Überblick zeigen.
                    </p>
                </article>
            </div>
        }
    </section>
</div>

@code {
    private const string EndkontrolleAreaKey = "Endkontrolle";
    private const string DefaultAreaKey = EndkontrolleAreaKey;

    private string ActiveAreaKey { get; set; } = DefaultAreaKey;
    private IReadOnlyDictionary<int, LiveFertigungEndkontrolleTableModel> EndkontrolleStationsByTable { get; set; } =
        CreateEmptyEndkontrolleTables();

    private static readonly IReadOnlyList<LiveAreaTab> Areas =
    [
        new("Endkontrolle", "Endkontrolle", "fa-solid fa-shield-heart", "Start mit Sauberraum und Arbeitsplatzsicht", "Erster geplanter Live-Bereich mit Vogelperspektive auf die einzelnen Arbeitsplätze der Endkontrolle.", "Arbeitsplätze, Material, Mitarbeiter, gemachte Menge und Zielmenge", "Die Endkontrolle soll als erste Ansicht die Arbeitsplätze von oben zeigen und pro Platz sofort erkennbar machen, wer gerade welches Material bearbeitet."),
        new("Wareneingang", "Wareneingang", "fa-solid fa-boxes-stacked", "Materialeingang und aktuelle Buchungslage", "Geplante Live-Übersicht für eingehende Materialien und den aktuellen Bearbeitungsstand im Wareneingang.", "Offene Eingänge, Bearbeiter und Materialfluss", "Der Bereich soll später schnell zeigen, was offen ist, was schon gebucht wurde und wo es noch Klärungsbedarf gibt."),
        new("Thermoformung", "Thermoformung", "fa-solid fa-temperature-three-quarters", "Aktive Aufträge und Maschinenbelegung", "Geplante Live-Ansicht für laufende Thermoformungs-Aufträge und die aktuelle Bearbeitung.", "Maschinenstatus, Auftrag und Produktionsfortschritt", "Hier soll später sichtbar werden, welche Aufträge laufen, wer daran arbeitet und wie weit die aktuelle Fertigung fortgeschritten ist."),
        new("UV", "UV", "fa-solid fa-sun", "UV-Bereich und Bearbeitungsstand", "Geplante Live-Ansicht für UV-Arbeitsplätze und deren aktuellen Fertigungsstatus.", "Arbeitsplatzstatus, Material und Fortschritt", "Der UV-Bereich bekommt später eine eigene Live-Sicht mit den wichtigsten Statusdaten direkt aus dem laufenden Betrieb."),
        new("Stanzen", "Stanzen", "fa-solid fa-cookie-bite", "Stanzplätze und aktuelle Belegung", "Geplante Live-Ansicht für aktive Stanzplätze mit Fokus auf Belegung und Produktionsstand.", "Arbeitsplatzbelegung und Stückzahlen", "Die Stanzbereiche sollen später im Überblick zeigen, welche Materialien gerade laufen und wie sich die Mengen entwickeln."),
        new("Fraesen", "Fräsen", "fa-solid fa-screwdriver-wrench", "Fräsplätze und Bearbeitungsfortschritt", "Geplante Live-Ansicht für Fräsarbeitsplätze und die aktuell laufenden Arbeiten.", "Mitarbeiter, Material und Bearbeitungsstand", "Für Fräsen ist eine eigene Live-Darstellung geplant, damit der aktuelle Stand direkt im Verwaltungsbereich sichtbar ist.")
    ];

    private static readonly IReadOnlyList<int> RoomOneLeftTables = [3, 2, 1];
    private static readonly IReadOnlyList<int> RoomOneRightTables = [5, 6, 7, 8];
    private static readonly IReadOnlyList<int> RoomTwoTables = [9, 10, 11, 12];

    private LiveAreaTab ActiveArea => Areas.FirstOrDefault(area => area.Key == ActiveAreaKey) ?? Areas[0];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            EndkontrolleStationsByTable = await LiveFertigungService.GetEndkontrolleTablesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Live-Fertigung konnte nicht geladen werden: {ex.Message}");
            EndkontrolleStationsByTable = CreateEmptyEndkontrolleTables();
        }
    }

    private void SelectArea(string areaKey)
    {
        ActiveAreaKey = areaKey;
    }

    private string GetTabButtonClass(string areaKey) =>
        areaKey == ActiveAreaKey
            ? "live-fertigung-tab-btn is-active"
            : "live-fertigung-tab-btn";

    private LiveFertigungEndkontrolleTableModel GetEndkontrolleStation(int tableNumber) =>
        EndkontrolleStationsByTable.TryGetValue(tableNumber, out var station)
            ? station
            : CreateEmptyEndkontrolleTable(tableNumber);

    private static IReadOnlyDictionary<int, LiveFertigungEndkontrolleTableModel> CreateEmptyEndkontrolleTables() =>
        Enumerable.Range(1, 12)
            .ToDictionary(tableNumber => tableNumber, CreateEmptyEndkontrolleTable);

    private static LiveFertigungEndkontrolleTableModel CreateEmptyEndkontrolleTable(int tableNumber) =>
        new()
        {
            TableNumber = tableNumber,
            IsOccupied = false,
            User = "-",
            Materials = [],
            DoneQuantity = 0,
            BadQuantity = 0,
            TargetQuantity = 0,
            WeekEntries = [],
            HistoryEntries = []
        };

    private static string GetEndkontrolleTableClass(LiveFertigungEndkontrolleTableModel station) =>
        station.IsOccupied
            ? "endkontrolle-table-card is-occupied"
            : "endkontrolle-table-card is-free";

    private static int GetProgressPercent(LiveFertigungEndkontrolleTableModel station) =>
        station.TargetQuantity > 0
            ? Math.Clamp((int)Math.Round(station.DoneQuantity / (double)station.TargetQuantity * 100), 0, 140)
            : 0;

    private static string GetProgressStyle(LiveFertigungEndkontrolleTableModel station) =>
        $"width:{Math.Min(GetProgressPercent(station), 100).ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    private static RenderFragment RenderEndkontrolleTable(LiveFertigungEndkontrolleTableModel station) => @<div class="endkontrolle-table-station">
        <div class="@GetEndkontrolleTableClass(station)">
            <div class="endkontrolle-table-topline">
                <span class="endkontrolle-table-label">Tisch @station.TableNumber</span>
                <span class="endkontrolle-table-state">
                    <span class="endkontrolle-table-state-dot"></span>
                    @(station.IsOccupied ? "belegt" : "frei")
                </span>
            </div>

            <div class="endkontrolle-table-main">
                <div class="endkontrolle-table-user-row">
                    <strong>@(station.IsOccupied ? station.User : "Nicht besetzt")</strong>
                    <span class="endkontrolle-target-pill">Ziel @(station.TargetQuantity > 0 ? station.TargetQuantity : "-")</span>
                </div>
                @if (station.Materials.Count == 0)
                {
                    <span class="endkontrolle-material-empty">Keine Zuweisung</span>
                }
                else
                {
                    <div class="endkontrolle-material-stack">
                        @foreach (var material in station.Materials)
                        {
                            <span>@material</span>
                        }
                    </div>
                }
            </div>

            <div class="endkontrolle-table-metrics">
                <div class="endkontrolle-metric-card is-good">
                    <span>Menge</span>
                    <strong>@station.DoneQuantity</strong>
                </div>
                <div class="endkontrolle-metric-card is-bad">
                    <span>Schlecht</span>
                    <strong>@station.BadQuantity</strong>
                </div>
            </div>

            <div class="endkontrolle-table-progress">
                <span style="@GetProgressStyle(station)"></span>
            </div>
        </div>

        <div class="endkontrolle-table-actions">
            <div class="endkontrolle-hover-action">
                <button type="button" class="endkontrolle-icon-btn" aria-label="Einträge der letzten Woche anzeigen">
                    <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                    <span class="endkontrolle-icon-tooltip">Einträge: letzte 7 Tage</span>
                </button>
                <div class="endkontrolle-hover-panel">
                    <div class="endkontrolle-hover-head">
                        <strong>Tisch @station.TableNumber: Einträge letzte 7 Tage</strong>
                        <span>@station.WeekEntries.Count Einträge</span>
                    </div>
                    <div class="endkontrolle-hover-legend">
                        <span>Datum / Material / Charge</span>
                        <span>Gut / Schlecht</span>
                    </div>
                    @if (station.WeekEntries.Count == 0)
                    {
                        <div class="endkontrolle-hover-empty">Keine Einträge in den letzten 7 Tagen</div>
                    }
                    else
                    {
                        @foreach (var entry in station.WeekEntries)
                        {
                            <div class="endkontrolle-hover-row">
                                <div>
                                    <strong>@entry.Date</strong>
                                    <span>@entry.Material</span>
                                    @if (!entry.MatchesAssignedMaterial)
                                    {
                                        <small class="text-warning">Zusätzliche Buchung</small>
                                    }
                                    <small>@entry.Charge</small>
                                </div>
                                <div class="endkontrolle-hover-values">
                                    <span class="text-success">@entry.Good</span>
                                    <span class="text-danger">@entry.Bad</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="endkontrolle-hover-action">
                <button type="button" class="endkontrolle-icon-btn" aria-label="Letzte Tage anzeigen">
                    <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
                    <span class="endkontrolle-icon-tooltip">Mengen: letzte 7 Tage</span>
                </button>
                <div class="endkontrolle-hover-panel is-history">
                    <div class="endkontrolle-hover-head">
                        <strong>Tisch @station.TableNumber: Mengen letzte 7 Tage</strong>
                        <span>Menge / Ziel</span>
                    </div>
                    <div class="endkontrolle-hover-legend">
                        <span>Datum / Material</span>
                        <span>Menge / Ziel</span>
                    </div>
                    @if (station.HistoryEntries.Count == 0)
                    {
                        <div class="endkontrolle-hover-empty">Keine Mengen in den letzten 7 Tagen</div>
                    }
                    else
                    {
                        @foreach (var entry in station.HistoryEntries)
                        {
                            <div class="endkontrolle-hover-row">
                                <div>
                                    <strong>@entry.Date</strong>
                                    <span>@entry.Material</span>
                                    @if (!entry.MatchesAssignedMaterial)
                                    {
                                        <small class="text-warning">Zusätzliche Buchung</small>
                                    }
                                </div>
                                <div class="endkontrolle-hover-values">
                                    <span>@entry.Done</span>
                                    <small>/ @(entry.Target.HasValue ? entry.Target.Value : "-")</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>;

    private sealed record LiveAreaTab(
        string Key,
        string Label,
        string Icon,
        string ShortDescription,
        string Description,
        string PrimaryFocusTitle,
        string PrimaryFocusText);
}
