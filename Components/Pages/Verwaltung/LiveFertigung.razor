@page "/verwaltung/live-fertigung"
@attribute [Authorize(Roles = "Admin,Verwaltung")]

<PageTitle>Live-Fertigung - Verwaltung</PageTitle>

<div class="qin-page-shell live-fertigung-page pb-4">
    <section class="glass-card qin-panel live-fertigung-hero">
        <div class="live-fertigung-title-row">
            <span class="live-fertigung-live-dot" aria-hidden="true"></span>
            <h2 class="live-fertigung-title mb-0">Live-Fertigung</h2>
        </div>
    </section>

    <section class="glass-card qin-panel live-fertigung-tabs-panel">
        <div class="live-fertigung-tabs-strip" role="tablist" aria-label="Produktionsbereiche">
            @foreach (var area in Areas)
            {
                <button type="button"
                        role="tab"
                        class="@GetTabButtonClass(area.Key)"
                        aria-selected="@(ActiveAreaKey == area.Key)"
                        @onclick="@(() => SelectArea(area.Key))">
                    <i class="@area.Icon" aria-hidden="true"></i>
                    <span>@area.Label</span>
                </button>
            }
        </div>
    </section>

    <section class="glass-card qin-panel live-fertigung-content-panel">
        <div class="live-fertigung-content-head live-fertigung-content-head-compact">
            <div>
                <h3 class="card-title-modern mb-0">@ActiveArea.Label</h3>
            </div>

            @if (ActiveAreaKey == "Endkontrolle")
            {
                <span class="live-fertigung-priority-badge">Erster Ausbau</span>
            }
        </div>

        @if (ActiveAreaKey == EndkontrolleAreaKey)
        {
            <div class="endkontrolle-live-shell">
                <div class="endkontrolle-layout-stage">
                    <section class="endkontrolle-room endkontrolle-room-one" aria-label="Raum 1">
                        <span class="endkontrolle-room-label">Raum 1</span>

                        <div class="endkontrolle-room-column endkontrolle-room-column-left">
                            @foreach (var station in RoomOneLeftStations)
                            {
                                @RenderEndkontrolleTable(station)
                            }
                        </div>

                        <div class="endkontrolle-top-station">
                            @RenderEndkontrolleTable(EndkontrolleStationsByTable[4])
                        </div>

                        <div class="endkontrolle-room-column endkontrolle-room-column-right">
                            @foreach (var station in RoomOneRightStations)
                            {
                                @RenderEndkontrolleTable(station)
                            }
                        </div>
                    </section>

                    <section class="endkontrolle-room endkontrolle-room-two" aria-label="Raum 2">
                        <span class="endkontrolle-room-label">Raum 2</span>

                        <div class="endkontrolle-room-column endkontrolle-room-column-left">
                            @foreach (var station in RoomTwoStations)
                            {
                                @RenderEndkontrolleTable(station)
                            }
                        </div>
                    </section>
                </div>
            </div>
        }
        else
        {
            <div class="live-fertigung-placeholder-grid">
                <article class="live-fertigung-placeholder-card is-primary">
                    <span class="modern-label">Geplanter Inhalt</span>
                    <h4>@ActiveArea.PrimaryFocusTitle</h4>
                    <p class="mb-0">@ActiveArea.PrimaryFocusText</p>
                </article>

                <article class="live-fertigung-placeholder-card">
                    <span class="modern-label">Nächster Schritt</span>
                    <h4>Live-Daten anbinden</h4>
                    <p class="mb-0">
                        Für diesen Bereich wird im nächsten Ausbauschritt die echte Belegung, Menge und Zielmenge auf die Seite gebracht.
                    </p>
                </article>

                <article class="live-fertigung-placeholder-card">
                    <span class="modern-label">Später geplant</span>
                    <h4>Hover-Details</h4>
                    <p class="mb-0">
                        Ein zusätzlicher Hover- oder Info-Button soll später auch ältere und bereits fertige Informationen direkt im Überblick zeigen.
                    </p>
                </article>
            </div>
        }
    </section>
</div>

@code {
